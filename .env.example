# Copy to .env and export before `mix phx.server` (or use direnv)

# Database (production)
DATABASE_URL=ecto://postgres:postgres@localhost/skill_bridge_dev
SECRET_KEY_BASE=generate_with_mix_phx_gen_secret
PHX_HOST=localhost
PORT=4000

# Stripe (optional — without these, dev uses simulated card payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=pkr

# Supabase Google OAuth (optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

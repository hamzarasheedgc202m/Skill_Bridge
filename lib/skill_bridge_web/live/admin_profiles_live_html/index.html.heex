<Layouts.app_admin
  flash={@flash}
  current_scope={@current_scope}
  current_user={@current_user}
  page_title={@page_title}
>
  <div class="space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">User profiles</h1>
        <p class="mt-1 text-sm text-slate-500">
          End users and service providers (excluding admins).
        </p>
      </div>
    </div>

    <form
      id="admin-profile-filter-form"
      phx-submit="filter"
      class="flex flex-wrap items-end gap-3"
    >
      <div>
        <label class="mb-1 block text-xs font-semibold text-slate-500" for="filter-role">
          Role
        </label>
        <select
          id="filter-role"
          name="role"
          class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm"
        >
          <option value="" selected={@filter_role == ""}>All</option>
          <option value="user" selected={@filter_role == "user"}>User</option>
          <option value="skilled_person" selected={@filter_role == "skilled_person"}>
            Service provider
          </option>
        </select>
      </div>
      <div class="min-w-[12rem] flex-1">
        <label class="mb-1 block text-xs font-semibold text-slate-500" for="filter-q">
          Search
        </label>
        <input
          id="filter-q"
          type="search"
          name="q"
          value={@filter_q}
          placeholder="Name, email, phone"
          class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
        />
      </div>
      <button
        type="submit"
        class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800"
      >
        Apply
      </button>
    </form>

    <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
        <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-3">Photo</th>
            <th class="px-4 py-3">Name</th>
            <th class="px-4 py-3">Role</th>
            <th class="px-4 py-3">Phone</th>
            <th class="px-4 py-3">Location</th>
            <th class="px-4 py-3">Email</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <%= for u <- @users do %>
            <tr class="hover:bg-slate-50/80">
              <td class="px-4 py-3">
                <.profile_avatar
                  src={profile_thumb(u)}
                  alt={u.name}
                  class="h-11 w-11 rounded-full object-cover border border-slate-200"
                />
              </td>
              <td class="px-4 py-3 font-medium text-slate-900">{u.name}</td>
              <td class="px-4 py-3">
                <span class={[
                  "inline-flex rounded-full px-2 py-0.5 text-xs font-semibold",
                  u.role == "skilled_person" && "bg-teal-50 text-teal-800",
                  u.role == "user" && "bg-sky-50 text-sky-800"
                ]}>
                  {role_label(u.role)}
                </span>
              </td>
              <td class="px-4 py-3 text-slate-600">{u.phone || "—"}</td>
              <td class="px-4 py-3 text-slate-600">{location_label(u)}</td>
              <td class="px-4 py-3 text-slate-500">{u.email}</td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= if @users == [] do %>
        <p class="px-4 py-8 text-center text-sm text-slate-500">
          No profiles match your filters.
        </p>
      <% end %>
    </div>
  </div>
</Layouts.app_admin>

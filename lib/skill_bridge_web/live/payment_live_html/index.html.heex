<Layouts.app flash={@flash} current_scope={@current_scope} current_user={@current_user}>
  <div class="max-w-xl mx-auto">

    <%!-- Header --%>
    <div class="mb-6 flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-600 to-violet-500 flex items-center justify-center shadow-lg shrink-0">
        <.icon name="hero-credit-card" class="w-6 h-6 text-white" />
      </div>
      <div>
        <h1 class="text-2xl font-bold text-base-content">Payment</h1>
        <p class="text-sm text-base-content/50">
          Booking #{ @booking.id} · {@profile.user.name} — {@profile.skill_category.name}
        </p>
      </div>
    </div>

    <%!-- ═══════════════════════════════════════════
         STATE 1: Already paid (completed payment)
    ═══════════════════════════════════════════ --%>
    <%= if @paid do %>
      <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-8 text-center mb-5">
        <div class="w-16 h-16 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-4">
          <.icon name="hero-check-badge" class="w-8 h-8 text-emerald-600" />
        </div>
        <h2 class="text-xl font-bold text-emerald-800 mb-1">Payment Successful</h2>
        <p class="text-sm text-emerald-700 mb-4">
          Your payment has been processed. The professional has been notified.
        </p>
        <%= for p <- @payments do %>
          <div class="inline-flex items-center gap-2 rounded-xl bg-emerald-100 px-3 py-1.5 text-xs font-mono text-emerald-700 mb-1.5">
            <.icon name="hero-receipt-percent" class="w-3 h-3" />
            {p.transaction_ref} · {pkr(p.amount_cents)} · {String.upcase(p.payment_method)}
          </div>
        <% end %>
      </div>
      <div class="flex gap-3 justify-center flex-wrap">
        <.link navigate={~p"/user/chat/#{@booking.id}"}
          class="flex items-center gap-2 px-5 py-2.5 bg-indigo-600 text-white rounded-xl font-semibold text-sm hover:bg-indigo-700 transition-colors no-underline">
          <.icon name="hero-chat-bubble-left-right" class="w-4 h-4" />
          Chat with Professional
        </.link>
        <.link navigate={~p"/user/bookings"}
          class="flex items-center gap-2 px-5 py-2.5 border border-base-300 text-base-content rounded-xl font-medium text-sm hover:bg-base-200 transition-colors no-underline">
          My Bookings
        </.link>
      </div>

    <%!-- ═══════════════════════════════════════════
         STATE 2: Manual payment pending confirmation
    ═══════════════════════════════════════════ --%>
    <% else %>
      <%= if @manual_pending do %>
        <%!-- Determine which method is pending --%>
        <%= cond do %>
          <% @payment_method == "cash" -> %>
            <div class="rounded-2xl border border-amber-200 bg-amber-50 p-8 mb-5">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center">
                  <span class="text-2xl">💵</span>
                </div>
                <div>
                  <h2 class="text-lg font-bold text-amber-900">Pay on Arrival</h2>
                  <p class="text-xs text-amber-700">Reference: <span class="font-mono">{@pending_ref}</span></p>
                </div>
              </div>
              <div class="space-y-2.5 text-sm text-amber-800 mb-5">
                <div class="flex items-start gap-2">
                  <.icon name="hero-check-circle" class="w-4 h-4 text-amber-600 mt-0.5 shrink-0" />
                  <span>Your booking is confirmed. Pay <strong class="font-bold">{pkr(@base_amount + @fee)}</strong> in cash when the professional arrives.</span>
                </div>
                <div class="flex items-start gap-2">
                  <.icon name="hero-check-circle" class="w-4 h-4 text-amber-600 mt-0.5 shrink-0" />
                  <span>Show your booking reference to the professional at the time of service.</span>
                </div>
                <div class="flex items-start gap-2">
                  <.icon name="hero-clock" class="w-4 h-4 text-amber-600 mt-0.5 shrink-0" />
                  <span>The admin will confirm your payment after the service is completed.</span>
                </div>
              </div>
              <div class="bg-amber-100 rounded-xl p-3 text-xs text-amber-700 font-mono">
                Booking #{ @booking.id} · {pkr(@base_amount + @fee)} · Cash
              </div>
            </div>

          <% @payment_method == "bank" -> %>
            <div class="rounded-2xl border border-blue-200 bg-blue-50 p-8 mb-5">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center">
                  <span class="text-2xl">🏦</span>
                </div>
                <div>
                  <h2 class="text-lg font-bold text-blue-900">Bank Transfer Instructions</h2>
                  <p class="text-xs text-blue-700">Reference: <span class="font-mono">{@pending_ref}</span></p>
                </div>
              </div>
              <div class="bg-white rounded-xl border border-blue-200 divide-y divide-blue-100 mb-4 text-sm">
                <div class="flex justify-between px-4 py-3">
                  <span class="text-base-content/50">Bank Name</span>
                  <span class="font-semibold">HBL / Meezan Bank</span>
                </div>
                <div class="flex justify-between px-4 py-3">
                  <span class="text-base-content/50">Account Title</span>
                  <span class="font-semibold">SkillBridge Pvt Ltd</span>
                </div>
                <div class="flex justify-between px-4 py-3">
                  <span class="text-base-content/50">Account No.</span>
                  <span class="font-mono font-semibold">1234-5678901-234</span>
                </div>
                <div class="flex justify-between px-4 py-3">
                  <span class="text-base-content/50">Amount</span>
                  <span class="font-bold text-blue-700">{pkr(@base_amount + @fee)}</span>
                </div>
                <div class="flex justify-between px-4 py-3">
                  <span class="text-base-content/50">Reference</span>
                  <span class="font-mono text-xs">{@pending_ref}</span>
                </div>
              </div>
              <p class="text-xs text-blue-700">
                ⚠️ Use your booking reference in the transfer note. Admin will confirm your payment after transfer.
              </p>
            </div>

          <% @payment_method == "wallet" -> %>
            <div class="rounded-2xl border border-violet-200 bg-violet-50 p-8 mb-5">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-xl bg-violet-100 flex items-center justify-center">
                  <span class="text-2xl">📱</span>
                </div>
                <div>
                  <h2 class="text-lg font-bold text-violet-900">Mobile Wallet Payment</h2>
                  <p class="text-xs text-violet-700">Reference: <span class="font-mono">{@pending_ref}</span></p>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3 mb-4">
                <div class="bg-white rounded-xl border border-violet-200 p-3 text-center">
                  <p class="text-lg mb-1">📲</p>
                  <p class="text-xs font-bold text-violet-800">JazzCash</p>
                  <p class="font-mono text-sm font-semibold mt-1">0300-1234567</p>
                </div>
                <div class="bg-white rounded-xl border border-violet-200 p-3 text-center">
                  <p class="text-lg mb-1">💳</p>
                  <p class="text-xs font-bold text-violet-800">EasyPaisa</p>
                  <p class="font-mono text-sm font-semibold mt-1">0333-9876543</p>
                </div>
              </div>
              <div class="bg-violet-100 rounded-xl p-3 text-sm text-violet-800 mb-3">
                <strong>Amount to send:</strong> {pkr(@base_amount + @fee)}<br />
                <strong>Description:</strong> {@pending_ref}
              </div>
              <p class="text-xs text-violet-700">
                ⚠️ Send the exact amount and include your booking reference. Admin will confirm once received.
              </p>
            </div>

          <% true -> %>
        <% end %>

        <div class="flex gap-3 justify-center flex-wrap">
          <.link navigate={~p"/user/chat/#{@booking.id}"}
            class="flex items-center gap-2 px-5 py-2.5 bg-indigo-600 text-white rounded-xl font-semibold text-sm hover:bg-indigo-700 transition-colors no-underline">
            <.icon name="hero-chat-bubble-left-right" class="w-4 h-4" />
            Chat with Professional
          </.link>
          <.link navigate={~p"/user/bookings"}
            class="flex items-center gap-2 px-5 py-2.5 border border-base-300 text-base-content rounded-xl font-medium text-sm hover:bg-base-200 transition-colors no-underline">
            My Bookings
          </.link>
        </div>

      <%!-- ═══════════════════════════════════════════
           STATE 3: Payment form (default)
      ═══════════════════════════════════════════ --%>
      <% else %>

        <%!-- Mode notice --%>
        <%= if @payments_mode == :simulated do %>
          <div class="flex items-center gap-2 rounded-xl bg-amber-50 border border-amber-200 px-4 py-2.5 mb-4 text-xs text-amber-700">
            <.icon name="hero-beaker" class="w-4 h-4 shrink-0" />
            <span><strong>Test mode:</strong> payments are simulated — no real charge.</span>
          </div>
        <% else %>
          <div class="flex items-center gap-2 rounded-xl bg-base-200 border border-base-300 px-4 py-2.5 mb-4 text-xs text-base-content/60">
            <.icon name="hero-lock-closed" class="w-4 h-4 shrink-0" />
            <span>
              Card payments use Stripe Checkout — we never store card numbers.
              <%= if !@stripe_ready do %>
                <span class="text-amber-600 font-medium"> STRIPE_SECRET_KEY not set.</span>
              <% end %>
            </span>
          </div>
        <% end %>

        <%!-- Order Summary --%>
        <div class="rounded-2xl border border-base-300 bg-base-100 p-5 mb-4 shadow-sm">
          <h3 class="text-sm font-bold text-base-content/60 uppercase tracking-wider mb-3">Order Summary</h3>
          <div class="space-y-2">
            <div class="flex justify-between text-sm">
              <span class="text-base-content/70">{@profile.skill_category.name} service</span>
              <span class="font-semibold">{pkr(@base_amount)}</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-base-content/70">
                Platform fee
                ({if @setting.platform_fee_type == "percentage",
                  do: "#{@setting.platform_fee_value}%",
                  else: "fixed"})
              </span>
              <span class="font-semibold text-amber-600">{pkr(@fee)}</span>
            </div>
            <div class="border-t border-base-300 pt-2 flex justify-between font-bold text-base">
              <span>Total</span>
              <span class="text-indigo-600">{pkr(@base_amount + @fee)}</span>
            </div>
          </div>
        </div>

        <%!-- Payment Method Selector --%>
        <div class="rounded-2xl border border-base-300 bg-base-100 p-5 mb-4 shadow-sm">
          <h3 class="text-sm font-bold text-base-content/60 uppercase tracking-wider mb-3">Payment Method</h3>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <%= for {label, icon, val, desc} <- [
              {"Card", "💳", "card", "Stripe / Online"},
              {"Bank Transfer", "🏦", "bank", "Direct transfer"},
              {"Mobile Wallet", "📱", "wallet", "JazzCash / EasyPaisa"},
              {"Cash", "💵", "cash", "Pay on arrival"}
            ] do %>
              <button
                id={"method-btn-#{val}"}
                phx-click="set_method"
                phx-value-method={val}
                class={[
                  "flex flex-col items-center gap-1.5 p-3 rounded-xl border-2 transition-all duration-200 cursor-pointer text-center",
                  if(@payment_method == val,
                    do: "border-indigo-500 bg-indigo-50 shadow-sm",
                    else: "border-base-300 bg-base-100 hover:border-indigo-300 hover:bg-base-200"
                  )
                ]}
              >
                <span class="text-2xl">{icon}</span>
                <span class={[
                  "text-xs font-bold leading-tight",
                  if(@payment_method == val, do: "text-indigo-700", else: "text-base-content/70")
                ]}>
                  {label}
                </span>
                <span class="text-[10px] text-base-content/40 leading-tight">{desc}</span>
              </button>
            <% end %>
          </div>
        </div>

        <%!-- Method-specific info panel --%>
        <%= cond do %>
          <% @payment_method == "cash" -> %>
            <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 mb-4 text-sm text-amber-800">
              <p class="font-semibold mb-1">💵 Pay on Arrival</p>
              <p class="text-xs">Have <strong>{pkr(@base_amount + @fee)}</strong> ready when the professional arrives. Your booking is confirmed immediately; payment is settled after the service.</p>
            </div>
          <% @payment_method == "bank" -> %>
            <div class="rounded-xl border border-blue-200 bg-blue-50 px-4 py-3 mb-4 text-sm text-blue-800">
              <p class="font-semibold mb-1">🏦 Bank Transfer</p>
              <p class="text-xs">After clicking Pay, you'll receive our bank account details. Transfer <strong>{pkr(@base_amount + @fee)}</strong> and include the booking reference. Admin confirms upon receipt.</p>
            </div>
          <% @payment_method == "wallet" -> %>
            <div class="rounded-xl border border-violet-200 bg-violet-50 px-4 py-3 mb-4 text-sm text-violet-800">
              <p class="font-semibold mb-1">📱 JazzCash / EasyPaisa</p>
              <p class="text-xs">After clicking Pay, you'll see our wallet number. Send <strong>{pkr(@base_amount + @fee)}</strong> and include the booking reference. Admin confirms upon receipt.</p>
            </div>
          <% true -> %>
        <% end %>

        <%!-- Pay Button --%>
        <button
          id="pay-btn"
          phx-click="pay"
          disabled={@processing or @base_amount == 0}
          class={[
            "w-full flex items-center justify-center gap-2.5 py-3.5 rounded-xl font-bold text-base transition-all duration-200",
            "focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2",
            if(@processing or @base_amount == 0,
              do: "bg-base-300 text-base-content/40 cursor-not-allowed",
              else: "bg-indigo-600 text-white hover:bg-indigo-700 active:scale-[0.98] shadow-lg shadow-indigo-500/20"
            )
          ]}
        >
          <%= if @processing do %>
            <span class="w-4 h-4 rounded-full border-2 border-white/30 border-t-white animate-spin"></span>
            Processing…
          <% else %>
            <.icon name="hero-lock-closed" class="w-4 h-4" />
            <%= cond do %>
              <% @payment_method == "card" -> %>
                Pay {pkr(@base_amount + @fee)} with Card
              <% @payment_method == "cash" -> %>
                Confirm Cash Booking — {pkr(@base_amount + @fee)}
              <% @payment_method == "bank" -> %>
                Get Bank Transfer Details — {pkr(@base_amount + @fee)}
              <% @payment_method == "wallet" -> %>
                Get Wallet Details — {pkr(@base_amount + @fee)}
              <% true -> %>
                Pay {pkr(@base_amount + @fee)}
            <% end %>
          <% end %>
        </button>

        <p class="text-center text-xs text-base-content/40 mt-3 mb-4">
          <.icon name="hero-shield-check" class="w-3 h-3 inline mr-1" />
          All payments are secure and protected by SkillBridge
        </p>

        <div class="text-center">
          <.link navigate={~p"/user/bookings"} class="text-sm text-base-content/50 hover:text-base-content transition-colors no-underline">
            ← Cancel and go back
          </.link>
        </div>

      <% end %>
    <% end %>

  </div>
</Layouts.app>

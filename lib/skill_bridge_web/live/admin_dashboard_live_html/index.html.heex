<Layouts.app flash={@flash} current_scope={@current_scope} current_user={@current_user}>
  
<!-- Hero header -->
  <div style="background:linear-gradient(135deg,#1A2744 0%,#2A3F6B 100%);border-radius:20px;padding:2rem 2.5rem;margin-bottom:2rem;display:flex;align-items:center;gap:1.5rem;position:relative;overflow:hidden">
    <div style="position:absolute;top:-30%;right:-5%;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(212,168,83,0.15) 0%,transparent 70%);pointer-events:none">
    </div>
    <div style="width:60px;height:60px;background:linear-gradient(135deg,#D4A853,#E8C47A);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:1.8rem;flex-shrink:0;box-shadow:0 8px 24px rgba(212,168,83,0.35)">
      🛡️
    </div>
    <div style="position:relative;z-index:2">
      <h1 style="font-family:'Playfair Display',serif;font-size:1.8rem;color:#fff;margin-bottom:0.2rem">
        Admin Dashboard
      </h1>
      <p style="color:rgba(255,255,255,0.55);font-size:0.88rem">
        Welcome, {@current_user.name} · Platform control center
      </p>
    </div>
  </div>
  
<!-- Stats grid -->
  <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:1rem;margin-bottom:2rem">
    <%= for {num, lbl, color, bg, icon} <- [
          {@pending_count,   "Pending",     "#D97706","#FFFBEB","⏳"},
          {@approved_count,  "Active Pros", "#065F46","#F0FDF4","✅"},
          {@total_bookings,  "Bookings",    "#1E40AF","#EFF6FF","📅"},
          {@open_complaints, "Complaints",  "#991B1B","#FEF2F2","⚠️"},
          {if(is_nil(@revenue), do: 0, else: @revenue), "Revenue PKR", "#5B21B6","#F5F3FF","💰"}
        ] do %>
      <div style={"background:#{bg};border:1px solid #{color}22;border-radius:16px;padding:1.2rem"}>
        <div style="font-size:1.4rem;margin-bottom:0.4rem">{icon}</div>
        <div style={"font-size:1.8rem;font-weight:700;color:#{color}"}>{num}</div>
        <div style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;color:#8FA3C0;font-weight:600">
          {lbl}
        </div>
      </div>
    <% end %>
  </div>
  
<!-- Action cards -->
  <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:1.2rem">
    <.link
      navigate={~p"/admin/skilled-persons"}
      style="background:#fff;border:1.5px solid #E8E5DF;border-radius:16px;padding:1.8rem;text-decoration:none;color:inherit;display:flex;align-items:flex-start;gap:1rem;transition:all 0.2s"
      onmouseover="this.style.borderColor='#1A2744';this.style.boxShadow='0 8px 24px rgba(26,39,68,0.08)'"
      onmouseout="this.style.borderColor='#E8E5DF';this.style.boxShadow='none'"
    >
      <div style="width:48px;height:48px;background:#F0F2F8;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0">
        👥
      </div>
      <div>
        <h3 style="font-weight:700;color:#1A2744;margin-bottom:0.3rem">Manage Professionals</h3>
        <p style="font-size:0.82rem;color:#8FA3C0;line-height:1.5">
          Approve/reject profiles, freeze accounts, view complaints & reviews
        </p>
        <%= if @pending_count > 0 do %>
          <span style="display:inline-block;margin-top:0.5rem;padding:0.25rem 0.6rem;background:#FFFBEB;border:1px solid #FDE68A;border-radius:100px;font-size:0.72rem;font-weight:600;color:#D97706">
            {@pending_count} pending →
          </span>
        <% end %>
      </div>
    </.link>

    <.link
      navigate={~p"/admin/complaints"}
      style="background:#fff;border:1.5px solid #E8E5DF;border-radius:16px;padding:1.8rem;text-decoration:none;color:inherit;display:flex;align-items:flex-start;gap:1rem;transition:all 0.2s"
      onmouseover="this.style.borderColor='#991B1B';this.style.boxShadow='0 8px 24px rgba(153,27,27,0.08)'"
      onmouseout="this.style.borderColor='#E8E5DF';this.style.boxShadow='none'"
    >
      <div style="width:48px;height:48px;background:#FEF2F2;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0">
        ⚠️
      </div>
      <div>
        <h3 style="font-weight:700;color:#1A2744;margin-bottom:0.3rem">Complaints Inbox</h3>
        <p style="font-size:0.82rem;color:#8FA3C0;line-height:1.5">
          Review and resolve all open user complaints
        </p>
        <%= if @open_complaints > 0 do %>
          <span style="display:inline-block;margin-top:0.5rem;padding:0.25rem 0.6rem;background:#FEF2F2;border:1px solid #FECACA;border-radius:100px;font-size:0.72rem;font-weight:600;color:#991B1B">
            {@open_complaints} open →
          </span>
        <% end %>
      </div>
    </.link>

    <.link
      navigate={~p"/admin/payments"}
      style="background:#fff;border:1.5px solid #E8E5DF;border-radius:16px;padding:1.8rem;text-decoration:none;color:inherit;display:flex;align-items:flex-start;gap:1rem;transition:all 0.2s"
      onmouseover="this.style.borderColor='#1A2744';this.style.boxShadow='0 8px 24px rgba(26,39,68,0.08)'"
      onmouseout="this.style.borderColor='#E8E5DF';this.style.boxShadow='none'"
    >
      <div style="width:48px;height:48px;background:#F5F3FF;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0">
        💰
      </div>
      <div>
        <h3 style="font-weight:700;color:#1A2744;margin-bottom:0.3rem">Payments & Revenue</h3>
        <p style="font-size:0.82rem;color:#8FA3C0;line-height:1.5">
          View platform revenue, transaction history, fee collections
        </p>
      </div>
    </.link>

    <.link
      navigate={~p"/admin/settings"}
      style="background:#fff;border:1.5px solid #E8E5DF;border-radius:16px;padding:1.8rem;text-decoration:none;color:inherit;display:flex;align-items:flex-start;gap:1rem;transition:all 0.2s"
      onmouseover="this.style.borderColor='#1A2744';this.style.boxShadow='0 8px 24px rgba(26,39,68,0.08)'"
      onmouseout="this.style.borderColor='#E8E5DF';this.style.boxShadow='none'"
    >
      <div style="width:48px;height:48px;background:#F0FDF4;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0">
        ⚙️
      </div>
      <div>
        <h3 style="font-weight:700;color:#1A2744;margin-bottom:0.3rem">Platform Settings</h3>
        <p style="font-size:0.82rem;color:#8FA3C0;line-height:1.5">
          Configure platform fee type and percentage charged per booking
        </p>
      </div>
    </.link>

    <div style="background:#fff;border:1.5px solid #E8E5DF;border-radius:16px;padding:1.8rem;display:flex;align-items:flex-start;gap:1rem">
      <div style="width:48px;height:48px;background:#FFF7ED;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0">
        📊
      </div>
      <div>
        <h3 style="font-weight:700;color:#1A2744;margin-bottom:0.3rem">Platform Health</h3>
        <div style="display:flex;flex-direction:column;gap:0.4rem;margin-top:0.5rem">
          <div style="display:flex;justify-content:space-between;font-size:0.82rem">
            <span style="color:#8FA3C0">Active professionals</span>
            <span style="font-weight:600;color:#065F46">{@approved_count}</span>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:0.82rem">
            <span style="color:#8FA3C0">Frozen accounts</span>
            <span style={"font-weight:600;color:#{if @frozen_count > 0, do: "#991B1B", else: "#065F46"}"}>
              {@frozen_count}
            </span>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:0.82rem">
            <span style="color:#8FA3C0">Open complaints</span>
            <span style={"font-weight:600;color:#{if @open_complaints > 0, do: "#991B1B", else: "#065F46"}"}>
              {@open_complaints}
            </span>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:0.82rem">
            <span style="color:#8FA3C0">Total bookings</span>
            <span style="font-weight:600;color:#1E40AF">{@total_bookings}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>

<Layouts.app flash={@flash} current_scope={@current_scope} current_user={@current_user}>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Complaints</h1>
      <p class="text-sm text-gray-500">Review and resolve user reports about professionals</p>
    </div>
    <.link navigate={~p"/admin"} class="text-sm text-slate-600 hover:text-slate-900">
      ← Admin dashboard
    </.link>
  </div>

  <div class="flex flex-wrap gap-2 mb-6">
    <%= for {label, val} <- [{"Open", "open"}, {"Resolved", "resolved"}, {"All", "all"}] do %>
      <button
        type="button"
        phx-click="filter"
        phx-value-status={val}
        class={[
          "px-3 py-1.5 rounded-lg text-xs font-semibold border transition-all",
          if(@filter_status == val,
            do: "bg-slate-800 text-white border-slate-800",
            else: "bg-white text-gray-600 border-gray-200 hover:border-gray-300"
          )
        ]}
      >
        {label}
      </button>
    <% end %>
  </div>

  <%= if @visible == [] do %>
    <div class="rounded-2xl border border-dashed border-gray-200 bg-white p-12 text-center text-gray-500">
      No complaints in this filter.
    </div>
  <% else %>
    <div class="space-y-4">
      <%= for c <- @visible do %>
        <div
          id={"complaint-#{c.id}"}
          class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm"
        >
          <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
            <div>
              <p class="font-semibold text-gray-900">
                #{c.id} · {c.user.name}
                <span class="text-gray-400 font-normal">→</span>
                {c.skilled_profile.user.name}
              </p>
              <p class="text-xs text-gray-400 mt-0.5">
                {Calendar.strftime(c.inserted_at, "%d %b %Y, %H:%M")}
              </p>
            </div>
            <span class={[
              "px-2 py-0.5 rounded-full text-xs font-semibold",
              if(c.status == "open",
                do: "bg-red-50 text-red-700 border border-red-100",
                else: "bg-emerald-50 text-emerald-700 border border-emerald-100"
              )
            ]}>
              {c.status}
            </span>
          </div>
          <p class="text-sm text-gray-700 whitespace-pre-wrap mb-4">{c.body}</p>
          <div class="flex gap-2">
            <%= if c.status == "open" do %>
              <button
                type="button"
                phx-click="resolve"
                phx-value-id={c.id}
                class="px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-semibold hover:bg-emerald-700"
              >
                Mark resolved
              </button>
            <% else %>
              <button
                type="button"
                phx-click="reopen"
                phx-value-id={c.id}
                class="px-3 py-1.5 bg-gray-100 text-gray-700 rounded-lg text-xs font-semibold hover:bg-gray-200"
              >
                Reopen
              </button>
            <% end %>
            <.link
              navigate={~p"/admin/skilled-persons"}
              class="px-3 py-1.5 text-xs font-medium text-slate-600 hover:text-slate-900"
            >
              View professional →
            </.link>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</Layouts.app>

<Layouts.app flash={@flash} current_scope={@current_scope} current_user={@current_user}>
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">My Bookings</h1>
      <p class="text-sm text-gray-500">{length(@bookings)} booking(s)</p>
    </div>
    <.link
      navigate={~p"/user/browse"}
      class="px-4 py-2 bg-slate-800 text-white rounded-xl text-sm font-medium hover:bg-slate-700 transition-all"
    >
      + New Booking
    </.link>
  </div>

  <%= if @bookings == [] do %>
    <div class="text-center py-16 bg-white rounded-2xl border border-gray-100">
      <div class="text-4xl mb-3">📅</div>
      <h3 class="font-semibold text-gray-700 mb-1">No bookings yet</h3>
      <p class="text-sm text-gray-400 mb-4">Find a professional and book your first service</p>
      <.link
        navigate={~p"/user/browse"}
        class="px-5 py-2.5 bg-slate-800 text-white rounded-xl text-sm font-semibold hover:bg-slate-700 transition-all"
      >
        Browse Services
      </.link>
    </div>
  <% else %>
    <div class="space-y-4">
      <%= for b <- @bookings do %>
        <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all">
          <%!-- ── Booking header ── --%>
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-slate-700 to-slate-500 flex items-center justify-center text-white text-sm font-bold flex-shrink-0">
                {String.first(b.skilled_profile.user.name)}
              </div>
              <div>
                <p class="font-semibold text-gray-900">{b.skilled_profile.user.name}</p>
                <p class="text-xs text-gray-400">
                  {b.skilled_profile.skill_category.name} · {fmt(b.scheduled_at)}
                </p>
                <p class="text-xs text-gray-400 mt-0.5">📍 {b.address}</p>
              </div>
            </div>
            <span class={"px-2.5 py-1 rounded-full text-xs font-semibold #{status_pill(b.status)}"}>
              {b.status}
            </span>
          </div>

          <%!-- ── Action buttons ── --%>
          <div class="flex gap-2 mt-4 flex-wrap">
            <.link
              navigate={~p"/user/chat/#{b.id}"}
              class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-medium transition-all flex items-center gap-1 relative"
            >
              💬 Chat
              <%= if Map.get(@unread_counts, b.id, 0) > 0 do %>
                <span class="ml-1 bg-red-500 text-white text-[10px] font-bold rounded-full px-1.5 py-0.5 leading-none">
                  {Map.get(@unread_counts, b.id)}
                </span>
              <% end %>
            </.link>

            <%= if b.status in ["pending", "confirmed"] do %>
              <.link
                navigate={~p"/live-location?booking_id=#{b.id}"}
                class="px-3 py-1.5 bg-teal-50 hover:bg-teal-100 text-teal-800 rounded-lg text-xs font-medium transition-all border border-teal-100"
              >
                📍 Live track
              </.link>
            <% end %>

            <%= cond do %>
              <% Map.get(@payment_statuses, b.id) == :paid -> %>
                <span class="px-3 py-1.5 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-semibold border border-emerald-100">
                  ✓ Paid
                </span>
              <% Map.get(@payment_statuses, b.id) == :pending -> %>
                <.link
                  navigate={~p"/user/pay/#{b.id}"}
                  class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-700 rounded-lg text-xs font-medium transition-all border border-amber-100"
                >
                  ⏳ Payment pending
                </.link>
              <% b.status == "confirmed" -> %>
                <.link
                  navigate={~p"/user/pay/#{b.id}"}
                  class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-700 rounded-lg text-xs font-medium transition-all border border-amber-100"
                >
                  💳 Pay
                </.link>
              <% true -> %>
            <% end %>

            <%= if b.status in ["pending", "confirmed"] do %>
              <button
                phx-click="cancel"
                phx-value-id={b.id}
                data-confirm="Cancel this booking?"
                class="px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg text-xs font-medium transition-all border border-red-100"
              >
                ✕ Cancel
              </button>
            <% end %>

            <%!-- ── Review (completed) & Complaint (confirmed/completed) ── --%>
            <%= if b.status == "completed" do %>
              <button
                phx-click="open_review"
                phx-value-id={b.id}
                class="px-3 py-1.5 bg-yellow-50 hover:bg-yellow-100 text-yellow-700 rounded-lg text-xs font-medium transition-all border border-yellow-200"
              >
                ⭐ Leave Review
              </button>
            <% end %>
            <%= if b.status in ["confirmed", "completed"] do %>
              <button
                phx-click="open_complaint"
                phx-value-id={b.id}
                class="px-3 py-1.5 bg-orange-50 hover:bg-orange-100 text-orange-700 rounded-lg text-xs font-medium transition-all border border-orange-200"
              >
                ⚠ File Complaint
              </button>
            <% end %>
          </div>

          <%!-- ── Inline Review Form ── --%>
          <%= if @review_booking_id == b.id do %>
            <div class="mt-4 pt-4 border-t border-gray-100">
              <h4 class="text-sm font-semibold text-gray-800 mb-3">Leave a Review</h4>

              <%!-- Star rating buttons --%>
              <div class="flex gap-1 mb-3">
                <%= for star <- 1..5 do %>
                  <button
                    phx-click="set_review_rating"
                    phx-value-rating={star}
                    class={"text-2xl transition-transform hover:scale-110 #{if star <= @review_rating, do: "opacity-100", else: "opacity-30"}"}
                  >
                    ⭐
                  </button>
                <% end %>
                <span class="text-sm text-gray-500 ml-2 self-center">{@review_rating}/5</span>
              </div>

              <textarea
                phx-keyup="set_review_body"
                phx-value-value=""
                phx-hook="TextareaValue"
                id={"review-body-#{b.id}"}
                rows="3"
                placeholder="Share your experience..."
                class="w-full text-sm border border-gray-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-100 resize-none"
              >{@review_body}</textarea>

              <div class="flex gap-2 mt-3">
                <button
                  phx-click="submit_review"
                  class="px-4 py-2 bg-slate-800 text-white rounded-xl text-xs font-semibold hover:bg-slate-700 transition-all"
                >
                  Submit Review
                </button>
                <button
                  phx-click="close_review"
                  class="px-4 py-2 bg-gray-100 text-gray-600 rounded-xl text-xs font-medium hover:bg-gray-200 transition-all"
                >
                  Cancel
                </button>
              </div>
            </div>
          <% end %>

          <%!-- ── Inline Complaint Form ── --%>
          <%= if @complaint_booking_id == b.id do %>
            <div class="mt-4 pt-4 border-t border-gray-100">
              <h4 class="text-sm font-semibold text-gray-800 mb-1">File a Complaint</h4>
              <p class="text-xs text-gray-400 mb-3">
                Describe the issue. Our moderation team will review it.
              </p>

              <textarea
                phx-keyup="set_complaint_body"
                phx-value-value=""
                id={"complaint-body-#{b.id}"}
                rows="4"
                placeholder="Describe the problem in detail (minimum 10 characters)..."
                class="w-full text-sm border border-gray-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-orange-100 resize-none"
              >{@complaint_body}</textarea>

              <div class="flex gap-2 mt-3">
                <button
                  phx-click="submit_complaint"
                  class="px-4 py-2 bg-orange-600 text-white rounded-xl text-xs font-semibold hover:bg-orange-700 transition-all"
                >
                  Submit Complaint
                </button>
                <button
                  phx-click="close_complaint"
                  class="px-4 py-2 bg-gray-100 text-gray-600 rounded-xl text-xs font-medium hover:bg-gray-200 transition-all"
                >
                  Cancel
                </button>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</Layouts.app>

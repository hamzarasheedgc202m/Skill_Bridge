<!DOCTYPE html>
<html lang="en" style="scroll-behavior:smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>SkillBridge — Hire Skilled Professionals</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=DM+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      *{box-sizing:border-box;margin:0;padding:0}
      :root{
        --cream:#FAFAF7;--warm-white:#F5F3EE;--soft-gold:#D4A853;--deep-navy:#1A2744;
        --slate:#3D4F6B;--mid-slate:#5B7096;--light-slate:#8FA3C0;--accent-teal:#2E9B8B;
        --accent-rose:#C4534A;--accent-amber:#E8A030;--border:#E2DDD5;--shadow:rgba(26,39,68,0.08);
      }
      body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--deep-navy);min-height:100vh}
      h1,h2,h3{font-family:'Playfair Display',serif}
      /* ── Sidebar nav ── */
      .logo{font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:800;color:var(--deep-navy);text-decoration:none;display:flex;align-items:center;gap:0.5rem}
      .logo-dot{width:10px;height:10px;background:var(--accent-teal);border-radius:50%;display:inline-block;flex-shrink:0}
      /* Desktop sidebar */
      .sidebar{position:fixed;top:0;left:0;bottom:0;width:256px;z-index:100;display:flex;flex-direction:column;background:#fff;border-right:1px solid var(--border);box-shadow:0 0 24px rgba(26,39,68,0.06);transition:transform 0.3s ease}
      .sidebar-header{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1.25rem 1rem;border-bottom:1px solid var(--border)}
      .sidebar-nav{flex:1;overflow-y:auto;padding:1rem 0.75rem;display:flex;flex-direction:column;gap:0.25rem}
      .sidebar-section-label{font-size:0.7rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--light-slate);padding:0.5rem 0.75rem 0.25rem}
      .sidebar-link{display:flex;align-items:center;gap:0.75rem;padding:0.6rem 0.75rem;border-radius:10px;text-decoration:none;font-size:0.88rem;font-weight:500;color:var(--mid-slate);transition:all 0.18s}
      .sidebar-link:hover{background:var(--warm-white);color:var(--deep-navy);transform:translateX(2px)}
      .sidebar-link.active{background:rgba(46,155,139,0.1);color:var(--accent-teal);font-weight:600}
      .sidebar-link-icon{font-size:1rem;flex-shrink:0;width:20px;text-align:center}
      .sidebar-footer{padding:1rem 1.25rem;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:0.5rem}
      /* Mobile top bar */
      .mobile-topbar{display:none;position:fixed;top:0;left:0;right:0;z-index:90;height:56px;align-items:center;gap:0.75rem;padding:0 1rem;background:rgba(250,250,247,0.96);backdrop-filter:blur(10px);border-bottom:1px solid var(--border)}
      .hamburger-btn{width:36px;height:36px;border:1px solid var(--border);border-radius:8px;background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:var(--mid-slate);flex-shrink:0;transition:background 0.15s}
      .hamburger-btn:hover{background:var(--warm-white)}
      /* Overlay */
      .sidebar-overlay{display:none;position:fixed;inset:0;z-index:95;background:rgba(0,0,0,0.45);backdrop-filter:blur(2px);opacity:0;transition:opacity 0.25s}
      .sidebar-overlay.visible{opacity:1}
      /* Content offset */
      .page-content{margin-left:256px;min-height:100vh}
      @media(max-width:1023px){
        .mobile-topbar{display:flex}
        .page-content{margin-left:0;padding-top:56px}
        .sidebar{transform:translateX(-100%)}
        .sidebar.open{transform:translateX(0)}
        .sidebar-overlay{display:block}
      }
      .btn{display:inline-flex;align-items:center;gap:0.4rem;padding:0.6rem 1.4rem;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:0.9rem;font-weight:500;cursor:pointer;text-decoration:none;border:none;transition:all 0.2s}
      .btn-ghost{background:transparent;color:var(--slate);border:1.5px solid transparent}
      .btn-ghost:hover{background:var(--warm-white);border-color:var(--border)}
      .btn-outline{background:transparent;color:var(--deep-navy);border:1.5px solid var(--deep-navy)}
      .btn-outline:hover{background:var(--deep-navy);color:#fff}
      .btn-primary{background:var(--deep-navy);color:#fff;border:1.5px solid var(--deep-navy)}
      .btn-primary:hover{background:var(--slate);transform:translateY(-1px);box-shadow:0 6px 20px var(--shadow)}
      .btn-teal{background:var(--accent-teal);color:#fff;border:1.5px solid var(--accent-teal)}
      .btn-teal:hover{background:#247a6e;transform:translateY(-1px);box-shadow:0 6px 20px rgba(46,155,139,0.3)}
      .btn-gold{background:var(--soft-gold);color:#fff;border:1.5px solid var(--soft-gold)}
      .btn-gold:hover{background:#b8913f;transform:translateY(-1px)}
      .btn-lg{padding:0.85rem 2rem;font-size:1rem;border-radius:10px}
      .btn-xl{padding:1rem 2.4rem;font-size:1.05rem;border-radius:12px}
      /* Hero */
      .hero{min-height:100vh;display:flex;align-items:center;padding-top:3rem;background:linear-gradient(135deg,var(--cream) 0%,var(--warm-white) 100%);position:relative;overflow:hidden}
      .hero-bg-1{position:absolute;top:-10%;right:-5%;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(46,155,139,0.08) 0%,transparent 70%);pointer-events:none}
      .hero-bg-2{position:absolute;bottom:-15%;left:-8%;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(212,168,83,0.1) 0%,transparent 70%);pointer-events:none}
      .hero-bg-3{position:absolute;top:30%;left:45%;width:2px;height:300px;background:linear-gradient(to bottom,transparent,var(--border),transparent);pointer-events:none}
      .hero-inner{max-width:1280px;margin:0 auto;padding:4rem 2rem;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}
      .hero-badge{display:inline-flex;align-items:center;gap:0.5rem;padding:0.4rem 1rem;background:rgba(46,155,139,0.1);border:1px solid rgba(46,155,139,0.25);border-radius:100px;font-size:0.8rem;color:var(--accent-teal);font-weight:500;margin-bottom:1.5rem}
      .hero-badge-dot{width:6px;height:6px;border-radius:50%;background:var(--accent-teal);animation:pulse 2s infinite}
      @keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}
      .hero h1{font-size:3.8rem;line-height:1.08;color:var(--deep-navy);margin-bottom:1.5rem}
      .hero h1 .accent{color:var(--accent-teal)}
      .hero-sub{font-size:1.15rem;color:var(--mid-slate);line-height:1.7;margin-bottom:2.5rem;font-weight:300}
      .hero-actions{display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:3rem}
      .hero-stats{display:flex;gap:2.5rem}
      .stat-item{text-align:left}
      .stat-num{font-family:'Playfair Display',serif;font-size:1.8rem;font-weight:700;color:var(--deep-navy)}
      .stat-lbl{font-size:0.78rem;color:var(--light-slate);text-transform:uppercase;letter-spacing:0.08em}
      /* Role Cards */
      .role-cards{display:flex;flex-direction:column;gap:1rem}
      .role-card{background:#fff;border:1.5px solid var(--border);border-radius:16px;padding:1.5rem;display:flex;align-items:center;gap:1.2rem;text-decoration:none;color:inherit;transition:all 0.25s;box-shadow:0 2px 12px var(--shadow)}
      .role-card:hover{border-color:var(--accent-teal);transform:translateX(6px);box-shadow:0 8px 32px var(--shadow)}
      .role-card.admin{border-color:rgba(212,168,83,0.4)}
      .role-card.admin:hover{border-color:var(--soft-gold)}
      .role-icon{width:52px;height:52px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0}
      .role-icon.user-icon{background:linear-gradient(135deg,#E8F4FE,#D0E8FB)}
      .role-icon.skilled-icon{background:linear-gradient(135deg,#E8F7F5,#C8EDE9)}
      .role-icon.admin-icon{background:linear-gradient(135deg,#FEF5E8,#FBE5C8)}
      .role-text h3{font-size:1rem;font-weight:600;margin-bottom:0.2rem;font-family:'DM Sans',sans-serif}
      .role-text p{font-size:0.82rem;color:var(--mid-slate)}
      .role-arrow{margin-left:auto;color:var(--light-slate);font-size:1.2rem;transition:transform 0.2s}
      .role-card:hover .role-arrow{transform:translateX(4px);color:var(--accent-teal)}
      /* Section */
      .section{padding:5rem 2rem;max-width:1280px;margin:0 auto}
      .section-label{font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--accent-teal);margin-bottom:0.8rem}
      .section-title{font-size:2.4rem;color:var(--deep-navy);margin-bottom:1rem}
      .section-sub{font-size:1.05rem;color:var(--mid-slate);max-width:560px;line-height:1.7}
      /* Services grid */
      .services-section{background:var(--warm-white);padding:5rem 2rem}
      .services-inner{max-width:1280px;margin:0 auto}
      .services-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:3rem}
      .services-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem}
      .service-card{background:#fff;border:1.5px solid var(--border);border-radius:16px;padding:1.8rem 1.4rem;text-align:center;text-decoration:none;color:inherit;transition:all 0.25s;cursor:pointer}
      .service-card:hover{border-color:transparent;transform:translateY(-6px);box-shadow:0 16px 40px var(--shadow)}
      .service-emoji{font-size:2.2rem;margin-bottom:1rem;display:block}
      .service-name{font-size:0.95rem;font-weight:600;color:var(--deep-navy);margin-bottom:0.3rem}
      .service-desc{font-size:0.78rem;color:var(--light-slate)}
      /* How it works */
      .how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-top:3rem}
      .how-card{padding:2rem;border-radius:16px;background:#fff;border:1.5px solid var(--border)}
      .how-num{font-family:'Playfair Display',serif;font-size:3rem;font-weight:800;color:var(--border);margin-bottom:1rem}
      .how-title{font-size:1rem;font-weight:600;margin-bottom:0.5rem}
      .how-desc{font-size:0.85rem;color:var(--mid-slate);line-height:1.6}
      /* Trust */
      .trust-section{background:var(--deep-navy);padding:5rem 2rem;color:#fff}
      .trust-inner{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}
      .trust-label{color:var(--accent-teal);font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:0.8rem}
      .trust h2{font-size:2.4rem;color:#fff;margin-bottom:1rem}
      .trust-sub{color:rgba(255,255,255,0.6);font-size:1rem;line-height:1.7;margin-bottom:2rem}
      .trust-features{display:flex;flex-direction:column;gap:1rem}
      .trust-feat{display:flex;align-items:flex-start;gap:1rem}
      .trust-feat-icon{width:36px;height:36px;border-radius:8px;background:rgba(46,155,139,0.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1rem}
      .trust-feat-text h4{font-size:0.9rem;font-weight:600;color:#fff;margin-bottom:0.2rem;font-family:'DM Sans',sans-serif}
      .trust-feat-text p{font-size:0.8rem;color:rgba(255,255,255,0.5)}
      .trust-cards{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
      .trust-stat-card{background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:1.8rem;text-align:center}
      .trust-stat-num{font-family:'Playfair Display',serif;font-size:2.2rem;font-weight:700;color:#fff;margin-bottom:0.3rem}
      .trust-stat-lbl{font-size:0.78rem;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:0.06em}
      /* CTA */
      .cta-section{padding:6rem 2rem;text-align:center;background:linear-gradient(135deg,var(--cream),var(--warm-white))}
      .cta-section h2{font-size:2.8rem;color:var(--deep-navy);margin-bottom:1rem}
      .cta-section p{font-size:1.05rem;color:var(--mid-slate);margin-bottom:2.5rem;max-width:500px;margin-left:auto;margin-right:auto}
      .cta-btns{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}
      /* Footer */
      .footer{background:var(--deep-navy);color:rgba(255,255,255,0.5);padding:2rem;text-align:center;font-size:0.82rem}
      /* Animations */
      @keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
      .fade-up{animation:fadeUp 0.7s ease both}
      .fade-up-1{animation-delay:0.1s}
      .fade-up-2{animation-delay:0.2s}
      .fade-up-3{animation-delay:0.35s}
      .fade-up-4{animation-delay:0.5s}
      @media(max-width:900px){
        .hero-inner{grid-template-columns:1fr;gap:2rem}
        .services-grid{grid-template-columns:repeat(2,1fr)}
        .how-grid{grid-template-columns:1fr}
        .trust-inner{grid-template-columns:1fr}
        .hero h1{font-size:2.6rem}
      }
      @media(max-width:1023px){
        .hero{padding-top:1rem}
      }
    </style>
  </head>
  <body>
    
<!-- MOBILE TOP BAR -->
    <div class="mobile-topbar">
      <button
        class="hamburger-btn"
        id="home-sidebar-open"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="home-sidebar"
        onclick="openSidebar()"
      >
        ☰
      </button>
      <a href="/" class="logo">
        <span class="logo-dot"></span> SkillBridge
      </a>
      <div style="margin-left:auto;display:flex;gap:0.5rem">
        <a
          href={~p"/login"}
          class="btn btn-outline"
          style="padding:0.4rem 0.9rem;font-size:0.82rem"
        >
          Log in
        </a>
        <a
          href={~p"/register"}
          class="btn btn-primary"
          style="padding:0.4rem 0.9rem;font-size:0.82rem"
        >
          Start
        </a>
      </div>
    </div>
    
<!-- SIDEBAR OVERLAY -->
    <div class="sidebar-overlay" id="home-sidebar-overlay" onclick="closeSidebar()"></div>
    
<!-- SIDEBAR -->
    <nav id="home-sidebar" class="sidebar" aria-label="Main navigation">
      <div class="sidebar-header">
        <a href="/" class="logo">
          <span class="logo-dot"></span> SkillBridge
        </a>
        <button
          onclick="closeSidebar()"
          class="hamburger-btn"
          aria-label="Close menu"
          style="width:32px;height:32px"
        >
          ✕
        </button>
      </div>

      <div class="sidebar-nav">
        <p class="sidebar-section-label">Navigation</p>
        <a href="#services" class="sidebar-link" onclick="closeSidebar()">
          <span class="sidebar-link-icon">🧰</span>Services
        </a>
        <a href="#how" class="sidebar-link" onclick="closeSidebar()">
          <span class="sidebar-link-icon">📋</span>How it works
        </a>
        <a href="/browse" class="sidebar-link">
          <span class="sidebar-link-icon">🔍</span>Browse Pros
        </a>
        <a href="/map" class="sidebar-link">
          <span class="sidebar-link-icon">🗺</span>Map
        </a>

        <div style="margin:0.75rem 0;border-top:1px solid var(--border)"></div>
        <p class="sidebar-section-label">Account</p>
        <a href={~p"/login"} class="sidebar-link">
          <span class="sidebar-link-icon">→</span>Sign in
        </a>
        <a href={~p"/register?role=user"} class="sidebar-link">
          <span class="sidebar-link-icon">👤</span>Hire a Pro
        </a>
        <a href={~p"/register?role=skilled_person"} class="sidebar-link">
          <span class="sidebar-link-icon">🔧</span>Offer Services
        </a>
        <a href={~p"/admin/login"} class="sidebar-link">
          <span class="sidebar-link-icon">🛡️</span>Admin Portal
        </a>
      </div>

      <div class="sidebar-footer">
        <a href={~p"/login"} class="btn btn-outline" style="justify-content:center">Log in</a>
        <a href={~p"/register"} class="btn btn-primary" style="justify-content:center">
          Get started
        </a>
      </div>
    </nav>
    
<!-- PAGE CONTENT -->
    <div class="page-content">
      <!-- HERO -->
      <section class="hero">
        <div class="hero-bg-1"></div>
        <div class="hero-bg-2"></div>
        <div class="hero-bg-3"></div>
        <div class="hero-inner">
          <!-- Left -->
          <div>
            <div class="hero-badge fade-up fade-up-1">
              <span class="hero-badge-dot"></span> Pakistan's #1 Skilled Professional Platform
            </div>
            <h1 class="fade-up fade-up-2">
              Find & Hire <span class="accent">Skilled</span> <br />Professionals<br />Near You
            </h1>
            <p class="hero-sub fade-up fade-up-3">
              Electricians, plumbers, mechanics, civil engineers, architects, teachers and more —
              vetted, verified, and ready to help on your schedule.
            </p>
            <div class="hero-actions fade-up fade-up-4">
              <a href="#services" class="btn btn-teal btn-xl">Browse Services</a>
              <a href={~p"/register"} class="btn btn-outline btn-xl">Register as Professional</a>
            </div>
            <div class="hero-stats fade-up fade-up-4">
              <div class="stat-item">
                <div class="stat-num">500+</div>
                <div class="stat-lbl">Professionals</div>
              </div>
              <div class="stat-item">
                <div class="stat-num">50+</div>
                <div class="stat-lbl">Cities</div>
              </div>
              <div class="stat-item">
                <div class="stat-num">4.9★</div>
                <div class="stat-lbl">Avg Rating</div>
              </div>
            </div>
          </div>
          
<!-- Right: Role Cards -->
          <div class="fade-up fade-up-3" style="padding-left:1rem">
            <p style="font-size:0.82rem;color:var(--light-slate);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:1rem;font-weight:600">
              I want to...
            </p>

            <div class="role-cards">
              <!-- User -->
              <a href={~p"/register?role=user"} class="role-card">
                <div class="role-icon user-icon">👤</div>
                <div class="role-text">
                  <h3>Hire a Skilled Person</h3>
                  <p>Browse profiles, book appointments, pay securely</p>
                </div>
                <span class="role-arrow">→</span>
              </a>
              
<!-- Skilled Person -->
              <a href={~p"/register?role=skilled_person"} class="role-card">
                <div class="role-icon skilled-icon">🔧</div>
                <div class="role-text">
                  <h3>Offer My Services</h3>
                  <p>Register as a professional, set availability, earn more</p>
                </div>
                <span class="role-arrow">→</span>
              </a>
              
<!-- Admin -->
              <a href={~p"/admin/login"} class="role-card admin">
                <div class="role-icon admin-icon">🛡️</div>
                <div class="role-text">
                  <h3>Admin Portal</h3>
                  <p>Platform administrators only — restricted access</p>
                </div>
                <span class="role-arrow" style="color:var(--soft-gold)">→</span>
              </a>
            </div>
          </div>
        </div>
      </section>
      
<!-- SERVICES -->
      <section class="services-section" id="services">
        <div class="services-inner">
          <div class="services-header">
            <div>
              <div class="section-label">Our Services</div>
              <h2 class="section-title">Every Skill You Need</h2>
            </div>
            <a href={~p"/browse"} class="btn btn-outline btn-lg" style="margin-bottom:0.5rem">
              View All & Book →
            </a>
          </div>

          <div class="services-grid">
            <%= for {cat, idx} <- Enum.with_index(@categories) do %>
              <a
                href={~p"/browse"}
                class="service-card"
                style={"animation: fadeUp 0.6s #{idx * 0.07}s ease both"}
              >
                <span class="service-emoji">{category_icon(cat.slug)}</span>
                <div class="service-name">{cat.name}</div>
                <div class="service-desc">Verified professionals</div>
              </a>
            <% end %>
          </div>

          <div style="text-align:center;margin-top:2.5rem">
            <a href={~p"/browse"} class="btn btn-teal btn-lg">
              Browse All Professionals →
            </a>
            <p style="font-size:0.8rem;color:var(--light-slate);margin-top:0.8rem">
              No account required to browse — login needed to book
            </p>
          </div>
        </div>
      </section>
      
<!-- HOW IT WORKS -->
      <section id="how" style="padding:5rem 2rem;max-width:1280px;margin:0 auto">
        <div class="section-label">Process</div>
        <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1rem">
          <h2 class="section-title">How SkillBridge Works</h2>
        </div>
        <div class="how-grid">
          <div class="how-card">
            <div class="how-num">01</div>
            <div class="how-title">Browse & Choose</div>
            <div class="how-desc">
              Explore professionals by category or region. See their availability, hourly rate, and reviews — no account needed.
            </div>
          </div>
          <div class="how-card">
            <div class="how-num">02</div>
            <div class="how-title">Book & Confirm</div>
            <div class="how-desc">
              Sign up in 30 seconds, pick your time slot, add your address. The professional confirms within minutes.
            </div>
          </div>
          <div class="how-card">
            <div class="how-num">03</div>
            <div class="how-title">Chat, Work & Pay</div>
            <div class="how-desc">
              Chat or call the professional in-app. After the job, pay securely through SkillBridge with full receipt and platform protection.
            </div>
          </div>
        </div>
      </section>
      
<!-- TRUST -->
      <section class="trust-section">
        <div class="trust-inner">
          <div>
            <div class="trust-label">Why SkillBridge</div>
            <h2 class="trust">Trusted by Thousands Across Pakistan</h2>
            <p class="trust-sub">

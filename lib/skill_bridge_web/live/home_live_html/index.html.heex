<div id="home-page-root" phx-hook="HomePage" class="home-page min-h-screen relative">
  <div class="sb-mesh-bg" aria-hidden="true"></div>
  <div class="sb-grid-overlay" aria-hidden="true"></div>
  <div data-scroll-progress class="sb-scroll-progress" aria-hidden="true"></div>
  <div data-cursor-glow class="sb-cursor-glow opacity-0" aria-hidden="true"></div>

  <%!-- ═══ NAVBAR ═══ --%>
  <header id="home-nav" class="home-nav">
    <div class="sb-nav-inner max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 font-bold text-xl">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-blue-600 to-teal-500 text-white text-xs font-extrabold shadow-lg shadow-blue-500/30">
          SB
        </span>
        <span class="sb-logo-text">SkillBridge</span>
      </a>

      <nav class="hidden lg:flex items-center gap-8 text-sm font-medium text-slate-600 dark:text-slate-300">
        <a
          href="#categories"
          data-nav-section
          class="hover:text-blue-600 transition-colors relative group"
        >
          Categories
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gradient-to-r from-blue-600 to-teal-500 transition-all group-hover:w-full">
          </span>
        </a>
        <a
          href="#featured"
          data-nav-section
          class="hover:text-blue-600 transition-colors relative group"
        >
          Professionals
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gradient-to-r from-blue-600 to-teal-500 transition-all group-hover:w-full">
          </span>
        </a>
        <a
          href="#how"
          data-nav-section
          class="hover:text-blue-600 transition-colors relative group"
        >
          How it works
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gradient-to-r from-blue-600 to-teal-500 transition-all group-hover:w-full">
          </span>
        </a>
        <a
          href="#testimonials"
          data-nav-section
          class="hover:text-blue-600 transition-colors relative group"
        >
          Reviews
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gradient-to-r from-blue-600 to-teal-500 transition-all group-hover:w-full">
          </span>
        </a>
      </nav>

      <div class="hidden lg:flex items-center gap-3">
        <button
          type="button"
          id="home-theme-toggle"
          class="p-2 rounded-lg border border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-white/80 transition"
          aria-label="Toggle dark mode"
        >
          <.icon name="hero-moon" class="w-5 h-5 dark:hidden" />
          <.icon name="hero-sun" class="w-5 h-5 hidden dark:block" />
        </button>
        <a
          href={~p"/login"}
          class="px-4 py-2 text-sm font-semibold text-slate-700 dark:text-slate-200 hover:text-blue-600 transition"
        >
          Log in
        </a>
        <a
          href={~p"/register?role=user"}
          class="sb-btn-primary sb-nav-cta px-5 py-2.5 rounded-xl text-sm font-semibold"
        >
          Get Started
        </a>
      </div>

      <button
        id="home-menu-open"
        type="button"
        class="lg:hidden p-2 rounded-lg border border-slate-200"
        aria-label="Open menu"
      >
        <.icon name="hero-bars-3" class="w-6 h-6" />
      </button>
    </div>
  </header>

  <div
    id="home-menu-overlay"
    class="hidden fixed inset-0 bg-black/40 z-40 lg:hidden"
    aria-hidden="true"
  >
  </div>

  <aside
    id="home-mobile-menu"
    class="home-mobile-menu fixed top-0 right-0 bottom-0 w-72 z-50 bg-white dark:bg-slate-900 shadow-2xl p-6 flex flex-col lg:hidden"
  >
    <div class="flex justify-between items-center mb-8">
      <span class="font-bold text-lg">Menu</span>
      <button id="home-menu-close" type="button" aria-label="Close menu">
        <.icon name="hero-x-mark" class="w-6 h-6" />
      </button>
    </div>
    <nav class="flex flex-col gap-4 text-slate-700 dark:text-slate-200 font-medium">
      <a href="#categories">Categories</a>
      <a href="#featured">Professionals</a>
      <a href="#how">How it works</a>
      <a href={~p"/browse"}>Browse</a>
      <a href={~p"/login"}>Log in</a>
      <a href={~p"/register"} class="sb-btn-primary text-center py-3 rounded-xl mt-4">
        Get Started
      </a>
    </nav>
  </aside>

  <%!-- ═══ HERO ═══ --%>
  <section class="sb-hero-section relative pt-28 pb-20 lg:pt-36 lg:pb-28 overflow-hidden">
    <div class="sb-aurora sb-aurora-1" aria-hidden="true"></div>
    <div class="sb-aurora sb-aurora-2" aria-hidden="true"></div>
    <div data-particles class="sb-particles"></div>
    <div
      class="sb-blob w-[420px] h-[420px] bg-blue-400/30 top-0 right-0"
      style="top:-5%;right:-8%"
    >
    </div>
    <div
      class="sb-blob sb-blob-2 w-[380px] h-[380px] bg-teal-400/25"
      style="bottom:5%;left:-10%"
    >
    </div>

    <span
      class="sb-float-icon hidden xl:block absolute top-32 right-[18%] text-4xl opacity-60"
      style="animation-delay:0.5s"
    >
      ⚡
    </span>
    <span
      class="sb-float-icon hidden xl:block absolute top-48 left-[12%] text-3xl opacity-50"
      style="animation-delay:1.2s"
    >
      🔧
    </span>
    <span
      class="sb-float-icon hidden xl:block absolute bottom-32 right-[28%] text-3xl opacity-50"
      style="animation-delay:0.8s"
    >
      💻
    </span>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="sb-reveal">
          <div class="sb-hero-badge inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-blue-700 dark:text-blue-300 text-sm font-medium mb-6">
            <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
            Pakistan's trusted skilled services platform
          </div>

          <h1 class="text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-extrabold leading-[1.05] mb-3">
            <span class="sb-gradient-text">SkillBridge</span>
          </h1>
          <p class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-800 dark:text-white tracking-tight mb-4 sb-tagline">
            Connect. Work. Grow.
          </p>

          <p class="text-lg text-slate-600 dark:text-slate-300 mb-2 max-w-xl leading-relaxed">
            Hire verified electricians, plumbers, developers, teachers, and more — or offer your expertise to clients who need you.
          </p>
          <p class="text-base text-slate-500 dark:text-slate-400 mb-6">
            <span
              data-typing
              data-phrases={
                Jason.encode!([
                  "Connect with verified professionals.",
                  "Work on projects that matter.",
                  "Grow your career with SkillBridge."
                ])
              }
            >
            </span>
          </p>

          <form
            action={~p"/browse"}
            method="get"
            class="sb-hero-search sb-reveal mb-6 max-w-xl"
            style="transition-delay:0.05s"
          >
            <div class="sb-hero-search-inner">
              <.icon name="hero-magnifying-glass" class="w-5 h-5 text-slate-400 shrink-0" />
              <input
                type="search"
                name="q"
                placeholder="Search electrician, plumber, tutor…"
                class="flex-1 bg-transparent border-0 outline-none text-slate-800 dark:text-white placeholder:text-slate-400 text-sm sm:text-base min-w-0"
                autocomplete="off"
              />
              <button
                type="submit"
                class="sb-btn-primary px-5 py-2.5 rounded-xl text-sm font-semibold shrink-0"
              >
                Search
              </button>
            </div>
          </form>

          <div class="flex flex-wrap items-center gap-2 mb-8">
            <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">Popular:</span>
            <%= for cat <- Enum.take(@display_categories, 5) do %>
              <a href={cat.href} class="sb-popular-chip">{cat.icon} {cat.name}</a>
            <% end %>
          </div>

          <div class="flex flex-wrap gap-4 mb-10">
            <a
              href={~p"/register?role=user"}
              class="sb-btn-primary sb-magnetic px-8 py-3.5 rounded-xl font-semibold text-sm sm:text-base"
            >
              Hire Skilled Workers
            </a>
            <a
              href={~p"/register?role=skilled_person"}
              class="sb-btn-secondary px-8 py-3.5 rounded-xl font-semibold text-sm sm:text-base"
            >
              Find Work
            </a>
          </div>

          <div class="flex flex-wrap gap-3">
            <div class="sb-hero-stat">
              <p class="text-2xl font-bold sb-gradient-text">{@platform_stats.workers}+</p>
              <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">
                Skilled workers
              </p>
            </div>
            <div class="sb-hero-stat">
              <p class="text-2xl font-bold text-amber-500">4.9★</p>
              <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">
                Avg rating
              </p>
            </div>
            <div class="sb-hero-stat">
              <p class="text-2xl font-bold text-teal-600">100%</p>
              <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">
                Verified pros
              </p>
            </div>
          </div>
        </div>

        <div class="sb-reveal space-y-4" style="transition-delay:0.15s">
          <div class="sb-hero-mockup">
            <div class="sb-mockup-bar">
              <span class="sb-mockup-dot bg-red-400"></span>
              <span class="sb-mockup-dot bg-amber-400"></span>
              <span class="sb-mockup-dot bg-emerald-400"></span>
              <span class="ml-3 text-xs text-slate-500 font-medium">
                skillbridge.app — booking
              </span>
            </div>
            <div class="p-5 space-y-3">
              <div class="flex items-center gap-3 p-3 rounded-xl bg-blue-500/5 border border-blue-500/10">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-600 to-teal-500 flex items-center justify-center text-white text-xs font-bold">
                  JD
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-slate-800 dark:text-white truncate">
                    John — Electrician
                  </p>
                  <p class="text-xs text-emerald-600 font-medium">✓ Verified · 4.9★</p>
                </div>
                <span class="sb-live-badge text-xs font-bold">● Live · Booked</span>
              </div>
              <div class="grid grid-cols-3 gap-2">
                <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800/50 text-center">
                  <p class="text-lg font-bold text-blue-600">24h</p>
                  <p class="text-[10px] text-slate-500">Response</p>
                </div>
                <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800/50 text-center">
                  <p class="text-lg font-bold text-teal-600">100%</p>
                  <p class="text-[10px] text-slate-500">Secure</p>
                </div>
                <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800/50 text-center">
                  <p class="text-lg font-bold text-slate-700 dark:text-white">PKR</p>
                  <p class="text-[10px] text-slate-500">Protected</p>
                </div>
              </div>
            </div>
          </div>
          <a
            href={~p"/register?role=user"}
            class="sb-glass-card sb-role-card p-5 flex items-center gap-4 group"
          >
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center text-xl shadow-lg">
              👤
            </div>
            <div class="flex-1">
              <h3 class="font-bold text-slate-900 dark:text-white text-sm">I need a service</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400">
                Browse, book, and pay protected
              </p>
            </div>
            <.icon
              name="hero-arrow-right"
              class="w-5 h-5 text-blue-500 group-hover:translate-x-1 transition-transform"
            />
          </a>
          <a
            href={~p"/register?role=skilled_person"}
            class="sb-glass-card sb-role-card p-5 flex items-center gap-4 group"
          >
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-teal-500 to-emerald-600 flex items-center justify-center text-xl shadow-lg">
              🛠️
            </div>
            <div class="flex-1">
              <h3 class="font-bold text-slate-900 dark:text-white text-sm">I offer skills</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400">
                Get approved and start earning
              </p>
            </div>
            <.icon
              name="hero-arrow-right"
              class="w-5 h-5 text-teal-500 group-hover:translate-x-1 transition-transform"
            />
          </a>
          <a
            href={~p"/browse"}
            class="sb-glass-card p-4 flex items-center justify-center gap-2 text-blue-600 font-semibold text-sm"
          >
            Explore without signing up →
          </a>
        </div>
      </div>
    </div>
  </section>

  <%!-- ═══ TRUST MARQUEE ═══ --%>
  <section
    class="py-8 border-y border-slate-200/60 dark:border-slate-700/40"
    aria-label="Trust indicators"
  >
    <div class="sb-marquee-wrap max-w-7xl mx-auto">
      <div class="sb-marquee-track">
        <span class="sb-trust-pill">🔒 Secure payments</span>
        <span class="sb-trust-pill">✓ Verified professionals</span>
        <span class="sb-trust-pill">⭐ 4.9 average rating</span>
        <span class="sb-trust-pill">📍 Pakistan-wide coverage</span>
        <span class="sb-trust-pill">💬 In-app messaging</span>
        <span class="sb-trust-pill">⚡ Fast booking</span>
        <span class="sb-trust-pill">🔒 Secure payments</span>
        <span class="sb-trust-pill">✓ Verified professionals</span>
        <span class="sb-trust-pill">⭐ 4.9 average rating</span>
        <span class="sb-trust-pill">📍 Pakistan-wide coverage</span>
        <span class="sb-trust-pill">💬 In-app messaging</span>
        <span class="sb-trust-pill">⚡ Fast booking</span>
      </div>
    </div>
  </section>

  <div class="sb-wave-divider" aria-hidden="true"></div>

  <%!-- ═══ CATEGORIES ═══ --%>
  <section id="categories" class="sb-section-categories py-20 lg:py-28 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14 sb-reveal">
        <span class="sb-section-tag mb-3">Categories</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4">
          Every skill you need
        </h2>
        <p class="text-slate-600 dark:text-slate-400">
          From home repairs to digital services — find verified professionals in one place.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-5 sb-stagger-parent sb-reveal">
        <%= for {cat, i} <- Enum.with_index(@display_categories) do %>
          <a
            href={cat.href}
            class="sb-glass-card sb-category-card sb-category-gradient sb-stagger-child p-6 text-center group"
            style={"transition-delay:#{i * 0.05}s"}
          >
            <span class="sb-category-icon-wrap group-hover:scale-110 transition-transform duration-300">
              {cat.icon}
            </span>
            <h3 class="font-semibold text-slate-900 dark:text-white text-sm sm:text-base">
              {cat.name}
            </h3>
            <p class="text-xs text-slate-500 mt-1">Verified pros</p>
          </a>
        <% end %>
      </div>
    </div>
  </section>

  <%!-- ═══ FEATURED WORKERS ═══ --%>
  <section id="featured" class="py-20 lg:py-28 sb-featured-bg relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap justify-between items-end gap-4 mb-12 sb-reveal">
        <div>
          <span class="sb-section-tag mb-3">Top rated</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white">
            Featured professionals
          </h2>
        </div>
        <a href={~p"/browse"} class="text-blue-600 font-semibold text-sm hover:underline">
          View all →
        </a>
      </div>

      <%= if @featured_workers == [] do %>
        <p class="text-center text-slate-500 sb-reveal">
          No featured professionals yet. Check back soon!
        </p>
      <% else %>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <%= for {profile, i} <- Enum.with_index(@featured_workers) do %>
            <% r = review_for(@review_stats, profile.id) %>
            <div
              class="sb-glass-card sb-pro-card sb-reveal overflow-hidden"
              style={"transition-delay:#{i * 0.08}s"}
            >
              <div class="p-6">
                <div class="flex items-start gap-4 mb-4">
                  <%= if profile.profile_image_url && profile.profile_image_url != "" do %>
                    <img
                      src={profile.profile_image_url}
                      alt={profile.user.name}
                      class="w-14 h-14 rounded-2xl object-cover sb-avatar-ring shadow"
                      loading="lazy"
                    />
                  <% else %>
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-600 to-teal-500 flex items-center justify-center text-white font-bold sb-avatar-ring">
                      {worker_initials(profile.user.name)}
                    </div>
                  <% end %>
                  <div class="flex-1 min-w-0">
                    <h3 class="font-bold text-slate-900 dark:text-white truncate">
                      {profile.user.name}
                    </h3>
                    <span class="sb-verified-badge mt-1">✓ Verified</span>
                    <span class="inline-block mt-1 ml-1 px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-700 dark:text-blue-300 text-xs font-medium">
                      {profile.skill_category.name}
                    </span>
                  </div>
                </div>

                <%= if r.avg do %>
                  <p class="text-sm mb-2">
                    <span class="text-amber-500 font-bold">★ {r.avg}</span>
                    <span class="text-slate-500"> ({r.count} reviews)</span>
                  </p>
                <% end %>

                <p class="text-sm text-slate-500 dark:text-slate-400 mb-1 flex items-center gap-1">
                  <.icon name="hero-map-pin" class="w-4 h-4 shrink-0" />
                  {profile.city || profile.region || "Pakistan"}
                </p>

                <%= if profile.hourly_rate_cents && profile.hourly_rate_cents > 0 do %>
                  <p class="text-sm font-semibold text-teal-600 mb-4">
                    PKR {div(profile.hourly_rate_cents, 100)}/hr
                  </p>
                <% end %>

                <a
                  href={~p"/browse"}
                  class="sb-btn-primary block w-full text-center py-2.5 rounded-xl text-sm font-semibold"
                >
                  Hire Now
                </a>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <%!-- ═══ HOW IT WORKS ═══ --%>
  <section id="how" class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 sb-reveal">
        <span class="sb-section-tag mb-3">Simple process</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white">
          How it works
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 relative">
        <div class="hidden lg:block absolute top-12 left-[12%] right-[12%] h-0.5 bg-gradient-to-r from-blue-500/20 via-teal-500/40 to-blue-500/20">
        </div>
        <%= for {step, icon, title, desc, i} <- [
                  {"1", "hero-user-plus", "Create Account", "Sign up as a client or skilled professional in under a minute.", 0},
                  {"2", "hero-magnifying-glass", "Search Skilled Person", "Browse categories, ratings, and locations to find the right match.", 1},
                  {"3", "hero-chat-bubble-left-right", "Connect Instantly", "Book, chat, and share live location — all inside the platform.", 2},
                  {"4", "hero-check-badge", "Get Work Done", "Pay securely, leave reviews, and build trust for next time.", 3}
                ] do %>
          <div
            class="sb-glass-card sb-step-card sb-reveal p-6 relative z-10"
            style={"transition-delay:#{i * 0.1}s"}
          >
            <div class="sb-step-num w-12 h-12 rounded-2xl bg-blue-600 text-white flex items-center justify-center font-bold text-lg mb-4 shadow-lg shadow-blue-500/30">
              {step}
            </div>
            <.icon name={icon} class="w-8 h-8 text-teal-500 mb-3" />
            <h3 class="font-bold text-slate-900 dark:text-white mb-2">{title}</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">{desc}</p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%!-- ═══ STATS ═══ --%>
  <section
    data-counters
    class="sb-stats-section py-16 bg-gradient-to-r from-blue-600 via-blue-700 to-slate-900 text-white relative overflow-hidden"
  >
    <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_30%_50%,#14b8a6,transparent_50%)]">
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center sb-reveal">
        <div class="sb-stat-card">
          <p
            class="sb-stat-num text-4xl lg:text-5xl font-extrabold mb-1"
            data-count={@platform_stats.workers}
            data-suffix="+"
          >
            0
          </p>
          <p class="text-sm text-blue-100 uppercase tracking-wider">Skilled Workers</p>
        </div>
        <div class="sb-stat-card">
          <p
            class="sb-stat-num text-4xl lg:text-5xl font-extrabold mb-1"
            data-count={@platform_stats.clients}
            data-suffix="+"
          >
            0
          </p>
          <p class="text-sm text-blue-100 uppercase tracking-wider">Clients</p>
        </div>
        <div class="sb-stat-card">
          <p
            class="sb-stat-num text-4xl lg:text-5xl font-extrabold mb-1"
            data-count={@platform_stats.jobs}
            data-suffix="+"
          >
            0
          </p>
          <p class="text-sm text-blue-100 uppercase tracking-wider">Jobs Completed</p>
        </div>
        <div class="sb-stat-card">
          <p
            class="sb-stat-num text-4xl lg:text-5xl font-extrabold mb-1"
            data-count={@platform_stats.satisfaction}
            data-suffix="%"
          >
            0
          </p>
          <p class="text-sm text-blue-100 uppercase tracking-wider">Satisfaction Rate</p>
        </div>
      </div>
    </div>
  </section>

  <%!-- ═══ TESTIMONIALS ═══ --%>
  <section id="testimonials" class="py-20 lg:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sb-reveal">
        <span class="sb-section-tag mb-3">Testimonials</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white">
          Trusted by our community
        </h2>
      </div>

      <div class="sb-reveal overflow-hidden rounded-2xl">
        <div data-testimonial-track class="sb-testimonial-track">
          <%= for t <- @testimonials do %>
            <div class="w-full flex-shrink-0 px-2">
              <div class="sb-glass-card sb-testimonial-card p-8 text-center pt-10">
                <img
                  src={t.image}
                  alt={t.name}
                  class="w-16 h-16 rounded-full mx-auto mb-4 object-cover sb-testimonial-avatar"
                  loading="lazy"
                />
                <p class="text-amber-400 text-lg mb-3">{String.duplicate("★", t.rating)}</p>
                <p class="text-slate-600 dark:text-slate-300 italic mb-6 leading-relaxed">
                  "{t.text}"
                </p>
                <p class="font-bold text-slate-900 dark:text-white">{t.name}</p>
                <p class="text-sm text-slate-500">{t.role}</p>
              </div>
            </div>
          <% end %>
        </div>
        <div class="flex justify-center gap-2 mt-6">
          <%= for {_t, i} <- Enum.with_index(@testimonials) do %>
            <button
              type="button"
              data-testimonial-dot
              class={"w-2.5 h-2.5 rounded-full transition-all #{if i == 0, do: "sb-dot-active", else: "bg-slate-300 dark:bg-slate-600"}"}
              aria-label={"Slide #{i + 1}"}
            >
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <%!-- ═══ CTA ═══ --%>
  <section class="sb-cta-section py-20 px-4 relative overflow-hidden">
    <div class="max-w-4xl mx-auto sb-glass-card sb-cta-glow p-10 sm:p-14 text-center sb-reveal bg-gradient-to-br from-blue-500/10 to-teal-500/10 relative z-10">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4">
        Ready to connect, work, and grow?
      </h2>
      <p class="text-slate-600 dark:text-slate-400 mb-8 max-w-lg mx-auto">
        Join SkillBridge today — whether you need a pro or you are one.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={~p"/register?role=user"}
          class="sb-btn-primary px-8 py-3.5 rounded-xl font-semibold"
        >
          Start Hiring
        </a>
        <a
          href={~p"/register?role=skilled_person"}
          class="sb-btn-secondary px-8 py-3.5 rounded-xl font-semibold"
        >
          Offer Services
        </a>
      </div>
    </div>
  </section>

  <%!-- ═══ FOOTER ═══ --%>
  <footer class="sb-footer text-slate-300 py-16 px-4">
    <div class="max-w-7xl mx-auto grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <div>
        <p class="font-bold text-white text-lg mb-1 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-teal-400"></span> SkillBridge
        </p>
        <p class="text-sm font-semibold text-teal-400/90 mb-2">Connect. Work. Grow.</p>
        <p class="text-sm text-slate-400 leading-relaxed">
          Connecting skilled workers with clients across Pakistan — verified, secure, and professional.
        </p>
        <div class="flex gap-3 mt-4">
          <a
            href="#"
            class="w-9 h-9 rounded-lg bg-white/10 flex items-center justify-center hover:bg-blue-600 transition"
            aria-label="Twitter"
          >
            𝕏
          </a>
          <a
            href="#"
            class="w-9 h-9 rounded-lg bg-white/10 flex items-center justify-center hover:bg-blue-600 transition"
            aria-label="LinkedIn"
          >
            in
          </a>
          <a
            href="#"
            class="w-9 h-9 rounded-lg bg-white/10 flex items-center justify-center hover:bg-blue-600 transition"
            aria-label="Facebook"
          >
            f
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-semibold text-white mb-4">Quick links</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={~p"/browse"} class="hover:text-teal-400 transition">Browse services</a>
          </li>
          <li><a href={~p"/register"} class="hover:text-teal-400 transition">Sign up</a></li>
          <li><a href={~p"/login"} class="hover:text-teal-400 transition">Log in</a></li>
          <li>
            <a href={~p"/admin/login"} class="hover:text-teal-400 transition">Admin portal</a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-white mb-4">Contact</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li>📧 support@skillbridge.local</li>
          <li>📍 Lahore, Pakistan</li>
          <li>🕐 Mon–Sat 9am–6pm PKT</li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-white mb-4">Newsletter</h4>
        <p class="text-sm text-slate-400 mb-3">Get updates on new categories and features.</p>
        <form phx-submit="newsletter" class="flex gap-2">
          <input
            type="email"
            name="email"
            required
            placeholder="you@email.com"
            class="flex-1 px-3 py-2 rounded-lg bg-white/10 border border-white/20 text-sm text-white placeholder:text-slate-500 focus:outline-none focus:border-teal-400"
          />
          <button
            type="submit"
            class="px-4 py-2 rounded-lg bg-teal-500 text-white text-sm font-semibold hover:bg-teal-400 transition"
          >
            Join
          </button>
        </form>
      </div>
    </div>

    <div class="max-w-7xl mx-auto mt-12 pt-8 border-t border-white/10 text-center text-sm text-slate-500">
      © {Date.utc_today().year} SkillBridge · Final Year Project · All rights reserved
    </div>
  </footer>
</div>

      </section>
      
<!-- CTA -->
      <section class="cta-section">
        <h2>Ready to Get Started?</h2>
        <p>Join thousands of happy clients and professionals on SkillBridge today.</p>
        <div class="cta-btns">
          <a href={~p"/register?role=user"} class="btn btn-primary btn-xl">I Need a Service</a>
          <a href={~p"/register?role=skilled_person"} class="btn btn-teal btn-xl">
            I'm a Professional
          </a>
        </div>

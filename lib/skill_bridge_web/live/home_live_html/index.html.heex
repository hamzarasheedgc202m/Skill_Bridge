              <div class="trust-feat">
                <div class="trust-feat-icon">💬</div>
                <div class="trust-feat-text">
                  <h4>Built-In Chat & Calls</h4>
                  <p>Coordinate directly with your professional before and during the job.</p>
                </div>
              </div>
              <div class="trust-feat">
                <div class="trust-feat-icon">⭐</div>
                <div class="trust-feat-text">
                  <h4>Real Reviews</h4>
                  <p>Only users who booked can leave reviews — no fake ratings.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="trust-cards">
            <div class="trust-stat-card">
              <div class="trust-stat-num">98%</div>
              <div class="trust-stat-lbl">Job Success</div>
            </div>
            <div class="trust-stat-card">
              <div class="trust-stat-num">24h</div>
              <div class="trust-stat-lbl">Avg Response</div>

<Layouts.app flash={@flash} current_scope={@current_scope} current_user={@current_user}>

  <%!-- ── HEADER ── --%>
  <div class="relative mb-5 flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h1 class="text-2xl font-bold text-base-content truncate">
        Welcome back, {@current_user.name} 👋
      </h1>
      <p class="mt-1 text-sm text-base-content/60">
        Here's your service activity at a glance
      </p>
    </div>
    <%!-- Avatar --%>
    <div class="shrink-0">
      <.profile_avatar
        src={@current_user.profile_image_path || ""}
        alt={@current_user.name}
        class="w-14 h-14 rounded-full object-cover border-2 border-base-300 shadow"
      />
    </div>
  </div>

  <%!-- ── STATS ROW ── --%>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
    <div class="rounded-2xl bg-gradient-to-br from-blue-500/15 to-blue-600/5 border border-blue-500/25 p-4">
      <p class="text-xs font-semibold uppercase tracking-widest text-base-content/50 mb-1">
        Total Bookings
      </p>
      <p class="text-xl font-bold text-blue-600">{length(@bookings)}</p>
      <p class="text-xs text-base-content/40 mt-0.5">all time</p>
    </div>
    <div class="rounded-2xl bg-gradient-to-br from-amber-500/15 to-amber-600/5 border border-amber-500/25 p-4">
      <p class="text-xs font-semibold uppercase tracking-widest text-base-content/50 mb-1">
        Pending
      </p>
      <p class="text-xl font-bold text-amber-600">{@pending_count}</p>
      <p class="text-xs text-base-content/40 mt-0.5">awaiting confirmation</p>
    </div>
    <div class="rounded-2xl bg-gradient-to-br from-emerald-500/15 to-emerald-600/5 border border-emerald-500/25 p-4">
      <p class="text-xs font-semibold uppercase tracking-widest text-base-content/50 mb-1">
        Confirmed
      </p>
      <p class="text-xl font-bold text-emerald-600">{@confirmed_count}</p>
      <p class="text-xs text-base-content/40 mt-0.5">active bookings</p>
    </div>
    <div class="rounded-2xl bg-gradient-to-br from-violet-500/15 to-violet-600/5 border border-violet-500/25 p-4">
      <p class="text-xs font-semibold uppercase tracking-widest text-base-content/50 mb-1">
        Total Paid
      </p>
      <p class="text-xl font-bold text-violet-600">
        PKR {trunc((@total_paid_cents || 0) / 100)}
      </p>
      <p class="text-xs text-base-content/40 mt-0.5">completed payments</p>
    </div>
  </div>

  <%!-- ── CLOCK + TODAY'S BOOKINGS + CHAT NOTIFICATIONS ── --%>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">

    <%!-- Left: Digital Clock + Today's Bookings --%>
    <div class="flex flex-col gap-4">
      <%!-- Clock Panel --%>
      <div class="rounded-2xl border border-slate-700 bg-gradient-to-br from-slate-900 to-slate-800 p-5">
        <div class="text-center">
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-3">
            🕐 Pakistan Standard Time
          </p>
          <div class="inline-flex items-center gap-1 font-mono rounded-xl px-4 py-2 bg-black/30 border border-slate-600/50">
            <span
              class="text-4xl font-bold text-emerald-400 tabular-nums leading-none tracking-wider"
              style="text-shadow: 0 0 20px rgba(52,211,153,0.6)"
            >
              {String.pad_leading(Integer.to_string(@now.hour), 2, "0")}
            </span>
            <span class="text-3xl text-emerald-600 font-bold animate-pulse">:</span>
            <span
              class="text-4xl font-bold text-emerald-400 tabular-nums leading-none tracking-wider"
              style="text-shadow: 0 0 20px rgba(52,211,153,0.6)"
            >
              {String.pad_leading(Integer.to_string(@now.minute), 2, "0")}
            </span>
            <span class="text-3xl text-emerald-600 font-bold animate-pulse">:</span>
            <span
              class="text-4xl font-bold text-emerald-300 tabular-nums leading-none tracking-wider"
              style="text-shadow: 0 0 20px rgba(52,211,153,0.5)"
            >
              {String.pad_leading(Integer.to_string(@now.second), 2, "0")}
            </span>
          </div>
          <p class="text-xs text-slate-500 mt-2">
            {Calendar.strftime(DateTime.to_date(@now), "%A, %d %B %Y")}
          </p>
        </div>
      </div>

      <%!-- Today's Bookings --%>
      <div class="rounded-2xl border border-base-300 bg-base-100 p-5 flex-1">
        <div class="flex items-center justify-between mb-4">
          <p class="font-semibold text-base-content">📅 Today's Appointments</p>
          <.link navigate={~p"/user/bookings"} class="text-xs text-primary hover:underline font-medium">
            View all →
          </.link>
        </div>

        <%= if length(@today_bookings) == 0 do %>
          <div class="flex flex-col items-center justify-center py-8 text-center">
            <div class="w-12 h-12 rounded-full bg-base-200 flex items-center justify-center mb-3">
              <.icon name="hero-calendar-days" class="w-6 h-6 text-base-content/30" />
            </div>
            <p class="text-sm text-base-content/50">No appointments today</p>
            <.link navigate={~p"/user/bookings"} class="mt-2 text-xs text-primary hover:underline">
              View all bookings
            </.link>
          </div>
        <% else %>
          <div class="flex flex-col gap-2">
            <%= for booking <- @today_bookings do %>
              <% time_str =
                if booking.scheduled_at,
                  do: Calendar.strftime(booking.scheduled_at, "%I:%M %p"),
                  else: "—" %>
              <.link
                navigate={~p"/user/bookings"}
                class="flex items-center gap-3 rounded-xl border border-base-300 bg-base-50 px-3 py-2.5 hover:border-primary transition-colors group"
              >
                <div class="text-center min-w-[52px]">
                  <p class="text-xs font-bold text-base-content/80 leading-tight">{time_str}</p>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-base-content truncate">
                    {booking.skilled_profile.user.name}
                  </p>
                  <p class="text-xs text-base-content/50 truncate">
                    {booking.skilled_profile.skill_category.name}
                  </p>
                </div>
                <span class={[
                  "shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full",
                  if(booking.status == "confirmed",
                    do: "bg-emerald-100 text-emerald-700",
                    else: "bg-amber-100 text-amber-700"
                  )
                ]}>
                  {booking.status}
                </span>
              </.link>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%!-- Right: Chat Notifications --%>
    <div class="rounded-2xl border border-base-300 bg-base-100 p-5">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2">
          <p class="font-semibold text-base-content">💬 Messages</p>
          <%= if @total_unread > 0 do %>
            <span class="flex items-center justify-center min-w-[20px] h-5 rounded-full bg-red-500 text-white text-xs font-bold px-1.5">
              {@total_unread}
            </span>
          <% end %>
        </div>
        <.link navigate={~p"/user/bookings"} class="text-xs text-primary hover:underline font-medium">
          All bookings →
        </.link>
      </div>

      <%= if @chat_notifications == [] do %>
        <div class="flex flex-col items-center justify-center py-8 text-center">
          <div class="w-12 h-12 rounded-full bg-base-200 flex items-center justify-center mb-3">
            <.icon name="hero-chat-bubble-left-right" class="w-6 h-6 text-base-content/30" />
          </div>
          <p class="text-sm text-base-content/50">No unread messages</p>
          <%= if length(@bookings) > 0 do %>
            <p class="text-xs text-base-content/40 mt-1">
              You have {length(@bookings)} booking(s) with chat available
            </p>
          <% end %>
        </div>
      <% else %>
        <div class="flex flex-col gap-2">
          <%= for booking <- @chat_notifications do %>
            <% unread = Map.get(@unread_map, booking.id, 0) %>
            <.link
              navigate={~p"/user/chat/#{booking.id}"}
              class="flex items-center gap-3 rounded-xl border border-base-300 bg-base-50 px-3 py-2.5 hover:border-primary transition-all duration-200 group"
            >
              <div class="w-10 h-10 rounded-full bg-indigo-500/15 flex items-center justify-center shrink-0">
                <.icon name="hero-user-circle" class="w-5 h-5 text-indigo-500" />
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-base-content truncate">
                  {booking.skilled_profile.user.name}
                </p>
                <p class="text-xs text-base-content/50 truncate">
                  {booking.skilled_profile.skill_category.name} · Booking #{booking.id}
                </p>
              </div>
              <div class="flex items-center justify-center min-w-[24px] h-6 rounded-full bg-red-500 text-white text-xs font-bold px-1.5 shrink-0 animate-pulse">
                {unread}
              </div>
            </.link>
          <% end %>
        </div>
        <%!-- Also show recent bookings with no unread if any --%>
        <% other_bookings = Enum.filter(@bookings, fn b ->
          Map.get(@unread_map, b.id, 0) == 0 and b.status in ["confirmed", "pending"]
        end) |> Enum.take(3) %>
        <%= if other_bookings != [] do %>
          <div class="mt-3 border-t border-base-200 pt-3">
            <p class="text-xs text-base-content/40 mb-2">Other active bookings</p>
            <%= for booking <- other_bookings do %>
              <.link
                navigate={~p"/user/chat/#{booking.id}"}
                class="flex items-center gap-2 rounded-lg px-2 py-1.5 hover:bg-base-200 transition-colors text-sm text-base-content/60"
              >
                <.icon name="hero-chat-bubble-left-right" class="w-4 h-4" />
                {booking.skilled_profile.user.name} — Booking #{booking.id}
              </.link>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <%!-- ── PAYMENT SUMMARY ── --%>
  <div class="rounded-2xl border border-base-300 bg-base-100 p-5 mb-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-semibold text-base-content">💳 Payment Summary</h2>
      <.link navigate={~p"/user/bookings"} class="text-xs text-primary hover:underline font-medium">
        View bookings →
      </.link>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-4">
      <div class="rounded-xl bg-emerald-50 border border-emerald-200 p-3">
        <p class="text-xs text-emerald-600 font-semibold uppercase tracking-wide mb-1">Total Paid</p>
        <p class="text-xl font-bold text-emerald-700">
          PKR {trunc((@total_paid_cents || 0) / 100)}
        </p>
      </div>
      <div class="rounded-xl bg-amber-50 border border-amber-200 p-3">
        <p class="text-xs text-amber-600 font-semibold uppercase tracking-wide mb-1">Pending</p>
        <p class="text-xl font-bold text-amber-700">{@pending_payment_count}</p>
        <p class="text-xs text-amber-600/70">payment(s)</p>
      </div>
      <div class="rounded-xl bg-blue-50 border border-blue-200 p-3 col-span-2 sm:col-span-1">
        <p class="text-xs text-blue-600 font-semibold uppercase tracking-wide mb-1">Transactions</p>
        <p class="text-xl font-bold text-blue-700">{length(@recent_payments)}</p>
        <p class="text-xs text-blue-600/70">completed</p>
      </div>
    </div>

    <%= if @recent_payments != [] do %>
      <div>
        <p class="text-xs font-semibold text-base-content/40 uppercase tracking-wider mb-2">
          Recent Transactions
        </p>
        <div class="flex flex-col divide-y divide-base-200">
          <%= for p <- @recent_payments do %>
            <div class="flex items-center justify-between py-2 text-sm">
              <div class="flex items-center gap-2 min-w-0">
                <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center shrink-0">
                  <.icon name="hero-check" class="w-3.5 h-3.5 text-emerald-600" />
                </div>
                <div class="min-w-0">
                  <p class="font-mono text-xs text-base-content/60 truncate">{p.transaction_ref}</p>
                  <p class="text-xs text-base-content/40">
                    {String.upcase(p.payment_method)}
                    · {Calendar.strftime(p.inserted_at, "%d %b %Y")}
                  </p>
                </div>
              </div>
              <span class="font-semibold text-emerald-700 shrink-0 ml-2">
                PKR {trunc(p.amount_cents / 100)}
              </span>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <p class="text-sm text-base-content/40 text-center py-4">No completed payments yet</p>
    <% end %>
  </div>

  <%!-- ── QUICK ACTION CARDS ── --%>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <.link
      navigate={~p"/user/browse"}
      class="group rounded-2xl border-2 border-base-300 bg-gradient-to-br from-base-100 to-base-200 p-6 hover:border-primary transition-all duration-300 hover:shadow-lg hover:scale-[1.02]"
    >
      <div class="flex items-start gap-4">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-indigo-500/20 to-violet-500/20 flex items-center justify-center group-hover:scale-110 transition-transform shrink-0">
          <.icon name="hero-magnifying-glass" class="w-7 h-7 text-indigo-600" />
        </div>
        <div class="flex-1 min-w-0">
          <h2 class="font-bold text-lg mb-1">Find Service Provider</h2>
          <p class="text-sm text-base-content/60 mb-3">
            Browse skilled professionals by category
          </p>
          <span class="text-indigo-600 text-sm font-semibold group-hover:underline">
            Browse services →
          </span>
        </div>
      </div>
    </.link>

    <.link
      navigate={~p"/user/bookings"}
      class="group rounded-2xl border-2 border-base-300 bg-gradient-to-br from-base-100 to-base-200 p-6 hover:border-primary transition-all duration-300 hover:shadow-lg hover:scale-[1.02]"
    >
      <div class="flex items-start gap-4">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-500/20 to-teal-500/20 flex items-center justify-center group-hover:scale-110 transition-transform shrink-0">
          <.icon name="hero-calendar-days" class="w-7 h-7 text-emerald-600" />
        </div>
        <div class="flex-1 min-w-0">
          <h2 class="font-bold text-lg mb-1">My Bookings</h2>
          <p class="text-sm text-base-content/60 mb-3">
            View and manage all your service bookings
          </p>
          <span class="text-emerald-600 text-sm font-semibold group-hover:underline">
            View bookings →
          </span>
        </div>
      </div>
    </.link>
  </div>

</Layouts.app>

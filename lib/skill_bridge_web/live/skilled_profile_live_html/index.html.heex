<Layouts.app flash={@flash} current_scope={@current_scope} current_user={@current_user}>
  <div style="margin-bottom:1.5rem">
    <h1 style="font-family:'Playfair Display',serif;font-size:1.8rem;font-weight:800;color:#1A2744;margin-bottom:0.2rem">
      My Professional Profile
    </h1>
    <p style="color:#8FA3C0;font-size:0.85rem">
      Complete your profile to start receiving bookings
    </p>
  </div>

  <div style="display:grid;grid-template-columns:1fr 300px;gap:1.5rem;align-items:start">
    
<!-- ── LEFT: Form ── -->
    <div>
      <.form for={@form} id="profile-form" phx-submit="save" phx-change="validate">
        
<!-- ①  Profile Photo -->
        <div style="background:#fff;border:1.5px solid #E8E5DF;border-radius:16px;padding:1.4rem;margin-bottom:1.1rem">
          <h3 style="font-weight:700;color:#1A2744;font-size:0.88rem;margin-bottom:1rem;text-transform:uppercase;letter-spacing:0.05em">
            ① Profile Photo
          </h3>
          <div id="skilled-photo-zone" phx-hook=".SkilledPhotoPreview" style="display:flex;align-items:flex-start;gap:1.2rem;flex-wrap:wrap">
            <!-- Preview avatar -->
            <div style="flex-shrink:0">
              <img
                id="skilled-photo-preview"
                src={if @image_preview != "", do: @image_preview, else: ""}
                alt="Profile preview"
                style={"width:80px;height:80px;border-radius:50%;object-fit:cover;border:3px solid #E8E5DF;#{if @image_preview == "", do: "display:none", else: ""}"}
                onerror="this.style.display='none';document.getElementById('avatar-fallback').style.display='flex'"
              />
              <div
                id="avatar-fallback"
                style={"width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#1A2744,#2E9B8B);display:#{if @image_preview == "", do: "flex", else: "none"};align-items:center;justify-content:center;color:#fff;font-size:1.8rem;font-weight:700;flex-shrink:0"}
              >
                {String.first(@current_user.name)}
              </div>
            </div>

            <!-- Upload zone -->
            <div style="flex:1;min-width:180px">
              <label
                for={@uploads.profile_photo.ref}
                style="display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:110px;border:2px dashed #C8D6E5;border-radius:12px;background:#F8FAFC;cursor:pointer;transition:all 0.2s"
                onmouseover="this.style.borderColor='#2E9B8B';this.style.background='#F0FDFA'"
                onmouseout="this.style.borderColor='#C8D6E5';this.style.background='#F8FAFC'"
              >
                <span style="font-size:1.5rem;margin-bottom:4px">📷</span>
                <span style="font-size:0.78rem;font-weight:600;color:#5B7096">Click to upload photo</span>
                <span style="font-size:0.7rem;color:#A0AEBF;margin-top:2px">JPG, PNG, WEBP — max 5MB</span>
                <.live_file_input upload={@uploads.profile_photo} style="display:none" />
              </label>

              <%= for entry <- @uploads.profile_photo.entries do %>
                <div style="margin-top:0.5rem;display:flex;align-items:center;gap:0.5rem;font-size:0.75rem;color:#2E9B8B;background:#F0FDFA;border-radius:8px;padding:0.4rem 0.6rem">
                  📎 <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{entry.client_name}</span>
                  <button
                    type="button"
                    phx-click="cancel_upload"
                    phx-value-ref={entry.ref}
                    style="margin-left:auto;color:#DC3545;background:none;border:none;cursor:pointer;font-size:0.9rem"
                  >
                    ✕
                  </button>
                </div>
                <%= for err <- upload_errors(@uploads.profile_photo, entry) do %>
                  <div style="color:#DC3545;font-size:0.72rem;margin-top:0.2rem">
                    ⚠ {upload_error_to_string(err)}
                  </div>
                <% end %>
              <% end %>
            </div>

            <script :type={Phoenix.LiveView.ColocatedHook} name=".SkilledPhotoPreview">
              export default {
                mounted() {
                  const input = this.el.querySelector('input[type="file"]');
                  const img = document.getElementById("skilled-photo-preview");
                  const fallback = document.getElementById("avatar-fallback");
                  if (input && img) {
                    input.addEventListener("change", e => {
                      const file = e.target.files[0];
                      if (file) {
                        const reader = new FileReader();
                        reader.onload = evt => {
                          img.src = evt.target.result;
                          img.style.display = "block";
                          if (fallback) fallback.style.display = "none";
                        };
                        reader.readAsDataURL(file);
                      }
                    });
                  }
                }
              }
            </script>
          </div>
        </div>


        <div class="mb-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="mb-3 text-xs font-bold uppercase tracking-wide text-slate-600">
            ② Personal details <span class="text-red-500">*</span>
          </h3>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label class="mb-1 block text-xs font-semibold text-slate-500" for="user-full-name">
                Full name
              </label>
              <input
                id="user-full-name"
                type="text"
                name="user[name]"
                value={@current_user.name}
                required
                class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none transition focus:border-teal-500"
              />
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold text-slate-500" for="profile-age">
                Age
              </label>
              <input
                id="profile-age"
                type="number"
                name="profile[age]"
                min="13"
                max="120"
                value={get_val(@form, :age)}
                required
                class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none transition focus:border-teal-500"
              />
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold text-slate-500" for="profile-gender">
                Gender
              </label>
              <select
                id="profile-gender"
                name="profile[gender]"
                required
                class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm outline-none transition focus:border-teal-500"
              >
                <option value="">Select</option>
                <%= for g <- SkillBridge.Accounts.User.genders() do %>
                  <option value={g} selected={get_val(@form, :gender) == g}>
                    {String.replace(g, "_", " ") |> String.capitalize()}
                  </option>
                <% end %>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label
                class="mb-1 block text-xs font-semibold text-slate-500"
                for="profile-education"
              >
                Education level
              </label>
              <select
                id="profile-education"
                name="profile[education_level]"
                required
                class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm outline-none transition focus:border-teal-500"
              >
                <option value="">Select</option>
                <%= for e <- SkillBridge.Accounts.User.education_levels() do %>
                  <option value={e} selected={get_val(@form, :education_level) == e}>
                    {e |> String.capitalize()}
                  </option>
                <% end %>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label class="mb-1 block text-xs font-semibold text-slate-500" for="profile-phone">
                Phone (Pakistan mobile)
              </label>
              <input
                id="profile-phone"
                type="tel"
                name="profile[phone]"
                placeholder="03XXXXXXXXX"
                pattern="03[0-9]{9}"
                maxlength="11"
                value={get_val(@form, :phone)}
                required
                class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none transition focus:border-teal-500"
              />
              <p class="mt-1 text-xs text-slate-400">11 digits starting with 03</p>
            </div>
          </div>
        </div>
        
<!-- ③ Skill & Rate -->
        <div style="background:#fff;border:1.5px solid #E8E5DF;border-radius:16px;padding:1.4rem;margin-bottom:1.1rem">
          <h3 style="font-weight:700;color:#1A2744;font-size:0.88rem;margin-bottom:1rem;text-transform:uppercase;letter-spacing:0.05em">
            ③ Skill & Rate
          </h3>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
            <div>
              <label style="display:block;font-size:0.72rem;font-weight:700;color:#5B7096;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem">
                Skill Category *
              </label>
              <select
                name="profile[skill_category_id]"
                style="width:100%;padding:0.72rem 1rem;border:1.5px solid #E8E5DF;border-radius:10px;font-family:inherit;font-size:0.88rem;outline:none;background:#fff;cursor:pointer"
                onfocus="this.style.borderColor='#2E9B8B'"
                onblur="this.style.borderColor='#E8E5DF'"
              >
                <option value="">Select skill</option>
                <%= for cat <- @categories do %>
                  <option
                    value={cat.id}
                    selected={get_val(@form, :skill_category_id) == to_string(cat.id)}
                  >
                    {cat.name}
                  </option>
                <% end %>
              </select>
            </div>
            <div>
              <label style="display:block;font-size:0.72rem;font-weight:700;color:#5B7096;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem">
                Hourly Rate (PKR)
              </label>
              <input
                type="number"
                name="profile[hourly_rate_cents]"
                min="0"
                value={get_val(@form, :hourly_rate_cents)}
                placeholder="e.g. 500"
                style="width:100%;padding:0.72rem 1rem;border:1.5px solid #E8E5DF;border-radius:10px;font-family:inherit;font-size:0.88rem;outline:none"
                onfocus="this.style.borderColor='#2E9B8B'"
                onblur="this.style.borderColor='#E8E5DF'"
              />
            </div>
          </div>
        </div>
        
<!-- ③ Bio -->
        <div style="background:#fff;border:1.5px solid #E8E5DF;border-radius:16px;padding:1.4rem;margin-bottom:1.1rem">
          <h3 style="font-weight:700;color:#1A2744;font-size:0.88rem;margin-bottom:1rem;text-transform:uppercase;letter-spacing:0.05em">
            ④ About You
          </h3>
          <textarea
            name="profile[bio]"
            rows="4"
            placeholder="Describe your experience, certifications, years of work..."
            style="width:100%;padding:0.72rem 1rem;border:1.5px solid #E8E5DF;border-radius:10px;font-family:inherit;font-size:0.88rem;outline:none;resize:vertical;line-height:1.6"
            onfocus="this.style.borderColor='#2E9B8B'"
            onblur="this.style.borderColor='#E8E5DF'"
          >{get_val(@form, :bio)}</textarea>
        </div>
        
<!-- ④ Pakistan Location -->
        <div style="background:#fff;border:1.5px solid #E8E5DF;border-radius:16px;padding:1.4rem;margin-bottom:1.1rem">
          <h3 style="font-weight:700;color:#1A2744;font-size:0.88rem;margin-bottom:1rem;text-transform:uppercase;letter-spacing:0.05em">
            ⑤ Location — Pakistan
          </h3>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.9rem">
            
<!-- Province -->
            <div>
              <label style="display:block;font-size:0.72rem;font-weight:700;color:#5B7096;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem">
                Province / Territory
              </label>
              <select
                name="province_select"
                phx-change="province_changed"
                style="width:100%;padding:0.72rem 1rem;border:1.5px solid #E8E5DF;border-radius:10px;font-family:inherit;font-size:0.88rem;outline:none;background:#fff;cursor:pointer"
                onfocus="this.style.borderColor='#2E9B8B'"
                onblur="this.style.borderColor='#E8E5DF'"
              >
                <option value="">Select Province</option>
                <%= for p <- SkillBridge.PakistanLocations.provinces() do %>
                  <option value={p} selected={@province == p}>{p}</option>
                <% end %>
              </select>
            </div>
            
<!-- District -->
            <div>
              <label style="display:block;font-size:0.72rem;font-weight:700;color:#5B7096;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem">
                District
              </label>
              <select
                name="district_select"
                phx-change="district_changed"
                style="width:100%;padding:0.72rem 1rem;border:1.5px solid #E8E5DF;border-radius:10px;font-family:inherit;font-size:0.88rem;outline:none;background:#fff;cursor:pointer"
                onfocus="this.style.borderColor='#2E9B8B'"
                onblur="this.style.borderColor='#E8E5DF'"
              >
                <option value="">Select District</option>
                <%= for d <- @districts do %>
                  <option value={d} selected={@district == d}>{d}</option>
                <% end %>
              </select>
            </div>
            
<!-- Tehsil -->
            <div>
              <label style="display:block;font-size:0.72rem;font-weight:700;color:#5B7096;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem">
                Tehsil
              </label>
              <select
                name="profile[tehsil]"
                style="width:100%;padding:0.72rem 1rem;border:1.5px solid #E8E5DF;border-radius:10px;font-family:inherit;font-size:0.88rem;outline:none;background:#fff;cursor:pointer"
              >
                <option value="">Select Tehsil</option>
                <%= for t <- @tehsils do %>
                  <option value={t} selected={get_val(@form, :tehsil) == t}>{t}</option>
                <% end %>
              </select>
            </div>
            
<!-- City -->
            <div>
              <label style="display:block;font-size:0.72rem;font-weight:700;color:#5B7096;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem">
                City
              </label>
              <select
                name="profile[city]"
                style="width:100%;padding:0.72rem 1rem;border:1.5px solid #E8E5DF;border-radius:10px;font-family:inherit;font-size:0.88rem;outline:none;background:#fff;cursor:pointer"
              >
                <option value="">Select City</option>
                <%= for c <- @cities do %>
                  <option value={c} selected={get_val(@form, :city) == c}>{c}</option>
                <% end %>
              </select>
            </div>
          </div>
          <!-- Hidden fields -->
          <input type="hidden" name="profile[province]" value={@province} />
          <input type="hidden" name="profile[district]" value={@district} />
          <input type="hidden" name="profile[region]" value="" />
          <%= if @province != "" do %>
            <div style="margin-top:0.8rem;padding:0.5rem 0.8rem;background:#F0FDF4;border-radius:8px;font-size:0.78rem;color:#2E9B8B;font-weight:500">
              📍 {@province} {if @district != "", do: "→ #{@district}"}
            </div>
          <% end %>
        </div>

        <div style="background:#fff;border:1.5px solid #E8E5DF;border-radius:16px;padding:1.4rem;margin-bottom:1.1rem">
          <h3 style="font-weight:700;color:#1A2744;font-size:0.88rem;margin-bottom:1rem;text-transform:uppercase;letter-spacing:0.05em">
            ⑥ Working Area (Approximate)
          </h3>
          <p style="font-size:0.78rem;color:#5B7096;margin-bottom:0.8rem">
            Click the map or use Detect Location to set your working area. Your exact address is never stored or shown to clients.
          </p>
          <div class="rounded-xl border border-base-300 overflow-hidden" style="height:280px">
            <div
              id="profile-location-map"
              phx-hook="SkilledLocationMap"
              data-lat={if @pin_lat, do: to_string(@pin_lat), else: "0"}
              data-lng={if @pin_lng, do: to_string(@pin_lng), else: "0"}
              style="height:100%;width:100%"
            >
            </div>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:0.8rem;margin-top:0.8rem;flex-wrap:wrap">
            <button
              type="button"
              phx-click="detect_location_pin"
              style="padding:0.5rem 0.9rem;background:#EFF6FF;color:#1E40AF;border:1px solid #BFDBFE;border-radius:8px;font-size:0.78rem;font-weight:600;cursor:pointer"
            >
              Use my current location
            </button>
            <p style="font-size:0.76rem;color:#8FA3C0">
              <%= if @pin_lat && @pin_lng do %>
                ✓ Area pinned (approximate location saved)
              <% else %>
                No pin selected yet
              <% end %>
            </p>
          </div>
          <%= if @location_label && @location_label != "" do %>
            <p style="margin-top:0.5rem;font-size:0.76rem;color:#2E9B8B">
              📍 {@location_label}
            </p>
          <% end %>
        </div>
        
<!-- ⑤ Weekly Schedule -->
        <div style="background:#fff;border:1.5px solid #E8E5DF;border-radius:16px;padding:1.4rem;margin-bottom:1.4rem">
          <h3 style="font-weight:700;color:#1A2744;font-size:0.88rem;margin-bottom:1rem;text-transform:uppercase;letter-spacing:0.05em">
            ⑦ Availability — Go to
          </h3>
          <.link
            navigate={~p"/skilled/availability"}
            style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.7rem 1.4rem;background:linear-gradient(135deg,#1A2744,#2A3F6B);color:#fff;border-radius:10px;text-decoration:none;font-size:0.88rem;font-weight:600"
          >
            📅 Edit Weekly Schedule
          </.link>
          <p style="font-size:0.75rem;color:#8FA3C0;margin-top:0.5rem">
            Set which days and hours you are available for bookings
          </p>
        </div>
        
<!-- Save -->
        <button
          type="submit"
          disabled={@saving}
          style="width:100%;padding:0.95rem;background:linear-gradient(135deg,#1A2744,#2A3F6B);color:#fff;border:none;border-radius:12px;font-size:1rem;font-weight:700;cursor:pointer;transition:opacity 0.2s"
          onmouseover="if(!this.disabled)this.style.opacity='0.88'"
          onmouseout="this.style.opacity='1'"
        >
          {if @saving, do: "Saving...", else: "💾 Save Profile"}
        </button>
      </.form>
    </div>
    
<!-- ── RIGHT: Sidebar ── -->
    <div style="position:sticky;top:80px;display:flex;flex-direction:column;gap:1rem">
      
<!-- Profile Completion -->
      <div style="background:#fff;border:1.5px solid #E8E5DF;border-radius:14px;padding:1.2rem">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.6rem">
          <p style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#8FA3C0">
            Profile Completion
          </p>
          <p style="font-size:0.75rem;font-weight:600;color:#5B7096">
            <%= if @completion do %>
              {@completion.completed}/{@completion.total}
            <% end %>
          </p>
        </div>
        <%= if @completion do %>
          <%!-- Progress bar --%>
          <div style="height:8px;background:#F0EFEA;border-radius:100px;overflow:hidden;margin-bottom:0.5rem">
            <div style={"height:100%;border-radius:100px;background:#{if @completion.percent == 100, do: "#22c55e", else: "#f97316"};width:#{@completion.percent}%;transition:width 0.5s ease"}>
            </div>
          </div>
          <p style={[
            "font-size:0.75rem;font-weight:600;margin-bottom:0.7rem;",
            if(@completion.percent == 100, do: "color:#22c55e", else: "color:#f97316")
          ]}>
            {@completion.percent}% complete
          </p>
          <%!-- Steps --%>
          <div style="display:flex;flex-direction:column;gap:0.3rem">
            <%= for step <- @onboarding_steps do %>
              <div style="display:flex;align-items:center;justify-content:space-between;padding:0.35rem 0.5rem;border-radius:7px;font-size:0.75rem;background:#F8F8F6">
                <span style="color:#5B7096">{step.label}</span>
                <span style={"font-weight:700;#{if step.done, do: "color:#22c55e", else: "color:#F97316"}"}>
                  {if step.done, do: "✓", else: "○"}
                </span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
      
<!-- Status -->
      <%= if @profile do %>
        <% {lbl, col, bg, msg} = status_info(@profile.status) %>
        <div style={"background:#{bg};border:1.5px solid #{col}33;border-radius:14px;padding:1.2rem"}>
          <p style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#8FA3C0;margin-bottom:0.4rem">
            Account Status
          </p>
          <p style={"font-weight:700;font-size:0.95rem;color:#{col}"}>{lbl}</p>
          <p style="font-size:0.75rem;color:#8FA3C0;margin-top:0.4rem;line-height:1.5">{msg}</p>
        </div>
      <% else %>
        <div style="background:#F0FDF4;border:1.5px solid #BBF7D0;border-radius:14px;padding:1.2rem">
          <p style="font-weight:700;color:#065F46;font-size:0.88rem">👋 New Profile</p>
          <p style="font-size:0.75rem;color:#8FA3C0;margin-top:0.4rem;line-height:1.5">
            Fill details and save. Admin will review and approve you.
          </p>
        </div>
      <% end %>
      
<!-- Quick links -->
      <div style="background:#fff;border:1.5px solid #E8E5DF;border-radius:14px;padding:1.2rem">
        <p style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#8FA3C0;margin-bottom:0.7rem">
          Quick Links
        </p>
        <div style="display:flex;flex-direction:column;gap:0.4rem">
          <%= for {path, icon, label} <- [{~p"/skilled", "🏠", "Dashboard"}, {~p"/skilled/availability", "📅", "Set Availability"}, {~p"/skilled/bookings", "📋", "My Bookings"}] do %>
            <.link
              navigate={path}
              style="display:flex;align-items:center;gap:0.5rem;padding:0.55rem 0.8rem;border-radius:8px;background:#F8F8F6;color:#1A2744;text-decoration:none;font-size:0.82rem;font-weight:500"
              onmouseover="this.style.background='#F0EFEA'"
              onmouseout="this.style.background='#F8F8F6'"
            >
              {icon} {label}
            </.link>
          <% end %>
        </div>
      </div>
      
<!-- Tips -->
      <div style="background:#FFFBEB;border:1.5px solid #FDE68A;border-radius:14px;padding:1.2rem">
        <p style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#D97706;margin-bottom:0.5rem">
          💡 Tips
        </p>
        <ul style="font-size:0.75rem;color:#92400E;line-height:1.7;padding-left:1rem;margin:0">
          <li>Upload a clear, professional photo</li>
          <li>Write detailed bio with experience</li>
          <li>Set competitive PKR rate</li>
          <li>Select your exact city</li>
          <li>Keep availability up to date</li>
        </ul>
      </div>
    </div>
  </div>
</Layouts.app>

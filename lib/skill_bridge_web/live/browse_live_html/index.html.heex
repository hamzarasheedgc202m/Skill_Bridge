<Layouts.app flash={@flash} current_scope={@current_scope} current_user={@current_user}>
  <div class="mb-8">
    <h1 class="text-4xl font-bold mb-2 bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
      Find Your Service Provider
    </h1>
    <p class="text-lg text-base-content/70">
      Choose a service category to browse available professionals
    </p>
  </div>

  <%!-- ── Keyword search ── --%>
  <div class="mb-6">
    <form phx-change="search" class="relative">
      <input
        type="text"
        name="q"
        value={@search}
        placeholder="🔎 Search by name, skill, city..."
        class="w-full px-4 py-3 pl-10 border border-gray-200 rounded-2xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-200 bg-white shadow-sm"
      />
      <span class="absolute left-3 top-3 text-gray-400 text-base">🔎</span>
    </form>
  </div>

  <%!-- ── Search results ── --%>
  <%= if @search_results do %>
    <div class="mb-8">
      <h2 class="text-lg font-semibold mb-3 text-gray-700">
        Results for "{@search}" ({length(@search_results)})
      </h2>
      <%= if @search_results == [] do %>
        <p class="text-gray-400 text-sm py-6 text-center">
          No professionals found. Try a different keyword.
        </p>
      <% else %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <%= for p <- @search_results do %>
            <.link
              navigate={~p"/user/browse/#{p.skill_category_id}"}
              class="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm hover:shadow-md transition-all flex items-start gap-3"
            >
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-slate-700 to-slate-500 flex items-center justify-center text-white text-sm font-bold flex-shrink-0">
                {String.first(p.user.name)}
              </div>
              <div>
                <p class="font-semibold text-gray-900 text-sm">{p.user.name}</p>
                <p class="text-xs text-gray-400">{p.skill_category.name}</p>
                <% r = review_for(@review_stats, p.id) %>
                <.star_rating avg={r.avg} count={r.count} class="text-xs" />
                <%= if p.city do %>
                  <p class="text-xs text-gray-400 mt-0.5">📍 {p.city}</p>
                <% end %>
              </div>
            </.link>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="mb-8">
    <h2 class="text-2xl font-semibold mb-4">Service Categories</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
      <%= for cat <- @categories do %>
        <.link
          navigate={~p"/user/browse/#{cat.id}"}
          class="card bg-gradient-to-br from-base-200 to-base-300 border-2 rounded-xl p-6 transition-all duration-300 hover:scale-105 hover:shadow-lg cursor-pointer group border-base-300 hover:border-primary"
        >
          <div class="flex flex-col items-center text-center">
            <div class="w-16 h-16 rounded-full flex items-center justify-center mb-3 transition-all group-hover:scale-110 bg-gradient-to-br from-primary/20 to-secondary/20 text-primary group-hover:from-primary/30 group-hover:to-secondary/30">
              <.icon name={get_icon(cat.slug)} class="w-8 h-8" />
            </div>
            <h3 class="font-semibold text-lg">{cat.name}</h3>
            <p class="text-xs text-base-content/60 mt-1">Open professionals</p>
          </div>
        </.link>
      <% end %>
    </div>
  </div>
</Layouts.app>
